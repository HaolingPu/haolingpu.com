---
import { getCollection } from "astro:content";
import ProjectRow from "@components/ProjectRow.astro";
import Container from "@components/ui/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Lang } from "@site.config";
import { PROJECTS } from "@site.config";

type Props = { lang?: Lang };
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const pill =
  "rounded-full border border-border px-3 py-1 font-mono text-[12px] text-fg-muted transition-colors hover:border-border-strong hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent-muted aria-pressed:text-accent";
---

<BaseLayout lang={lang} title={zh ? "项目" : PROJECTS.TITLE} description={zh ? "我做过的东西，能公开的都附了代码。" : PROJECTS.DESCRIPTION}>
  <Container>
    <h1 class="animate text-[28px] font-semibold tracking-tight">{zh ? "项目" : "Projects"}</h1>
    <p class="animate mt-2 text-fg-muted">{zh ? "我做过的东西，能公开的都附了代码。" : PROJECTS.DESCRIPTION}</p>
    <div class="animate mt-6 flex flex-wrap gap-1.5" data-filter-bar>
      <button type="button" data-filter="" aria-pressed="true" class={pill}>{zh ? "全部" : "all"}</button>
      {tags.map((t) => <button type="button" data-filter={t} aria-pressed="false" class={pill}>{t}</button>)}
    </div>
    <ul class="rule-list animate mt-6" data-project-grid>
      {projects.map((p) => <li data-tags={p.data.tags.join(" ")} class="contents"><ProjectRow project={p} lang={lang} /></li>)}
    </ul>
    <p class="mt-6 hidden text-sm text-fg-subtle" data-empty>{zh ? "还没有这个标签的项目。" : "Nothing tagged that yet."}</p>
  </Container>
</BaseLayout>

<script>
  function init() {
    const bar = document.querySelector<HTMLElement>("[data-filter-bar]");
    const grid = document.querySelector<HTMLElement>("[data-project-grid]");
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    if (!bar || !grid || bar.dataset.ready) return;
    bar.dataset.ready = "1";
    const pills = bar.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const rows = grid.querySelectorAll<HTMLElement>("[data-tags]");
    bar.addEventListener("click", (e) => {
      const pill = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!pill) return;
      const tag = pill.dataset.filter ?? "";
      pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
      let shown = 0;
      rows.forEach((r) => {
        const show = !tag || (r.dataset.tags ?? "").split(" ").includes(tag);
        r.classList.toggle("hidden", !show);
        r.classList.toggle("contents", show);
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  }
  init();
  document.addEventListener("astro:after-swap", init);
</script>
