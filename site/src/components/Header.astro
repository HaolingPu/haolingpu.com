---
import Container from "@components/ui/Container.astro";
import { NAV, SITE } from "@site.config";

const path = Astro.url.pathname;
const items = NAV.filter((n) => n.ENABLED);
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <Container size="wide">
    <div class="flex items-center justify-between gap-6">
      <a
        href="/"
        aria-label={`${SITE.NAME} — home`}
        class="flex items-center gap-2.5 text-fg transition-colors hover:text-fg"
      >
        <span
          class="flex size-7 items-center justify-center rounded-md bg-fg font-mono text-[13px] font-bold leading-none text-bg"
          aria-hidden="true"
        >
          hp
        </span>
        <span class="text-sm font-medium">{SITE.NAME}</span>
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-1 sm:flex">
        {
          items.map((item) => (
            <a
              href={item.HREF}
              aria-current={isActive(item.HREF) ? "page" : undefined}
              class:list={[
                "rounded-md px-2.5 py-1.5 font-mono text-[13px] transition-colors duration-200 ease-out-quart",
                isActive(item.HREF)
                  ? "text-fg underline decoration-accent decoration-2 underline-offset-[6px]"
                  : "text-fg-muted hover:text-fg",
              ]}
            >
              {item.LABEL}
            </a>
          ))
        }
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle dark / light theme"
          class="ml-2 flex size-8 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-surface hover:text-fg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </nav>

      <button
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex size-9 items-center justify-center rounded-md border border-border text-fg-muted transition-colors hover:text-fg sm:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="menu-icon-open">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="menu-icon-close hidden">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </Container>

  <div
    id="mobile-menu"
    hidden
    class="fixed inset-x-0 top-[65px] bottom-0 z-40 overflow-y-auto bg-bg px-5 py-8 sm:hidden"
  >
    <nav aria-label="Primary (mobile)" class="flex flex-col">
      {
        items.map((item) => (
          <a
            href={item.HREF}
            aria-current={isActive(item.HREF) ? "page" : undefined}
            class:list={[
              "border-b border-border py-5 font-mono text-2xl transition-colors",
              isActive(item.HREF) ? "text-accent" : "text-fg",
            ]}
          >
            {item.LABEL}
          </a>
        ))
      }
      <a href="/" class="border-b border-border py-5 font-mono text-2xl text-fg-muted">home</a>
    </nav>
    <div class="mt-8 flex items-center justify-between font-mono text-xs text-fg-subtle">
      <span>{SITE.DOMAIN}</span>
      <button type="button" data-theme-toggle class="rounded-md border border-border px-3 py-1.5 text-fg-muted">
        toggle theme
      </button>
    </div>
  </div>
</header>
