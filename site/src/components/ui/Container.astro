---
import { cn } from "@lib/utils";

/** Page-width wrapper. `prose` = 68ch reading column, `wide` = 1100px grid. */
type Props = { size?: "prose" | "wide"; class?: string };
const { size = "prose", class: className } = Astro.props;
---

<div
  class={cn(
    "mx-auto w-full px-5 sm:px-8",
    size === "prose" ? "max-w-[58rem]" : "max-w-[1100px]",
    className,
  )}
>
  <slot />
</div>
