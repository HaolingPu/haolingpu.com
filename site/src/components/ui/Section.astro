---
import { cn } from "@lib/utils";

/** Section with a small-caps label, optional title and right-aligned action. */
type Props = { eyebrow?: string; title?: string; class?: string; id?: string };
const { eyebrow, title, class: className, id } = Astro.props;
---

<section id={id} class={cn("py-8 sm:py-10", className)}>
  {
    (eyebrow || title || Astro.slots.has("action")) && (
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <div class="flex items-baseline gap-3">
          {eyebrow && <span class="label">{eyebrow}</span>}
          {title && <h2 class="text-[17px] font-semibold tracking-tight">{title}</h2>}
        </div>
        {Astro.slots.has("action") && (
          <div class="text-sm">
            <slot name="action" />
          </div>
        )}
      </div>
    )
  }
  <slot />
</section>
