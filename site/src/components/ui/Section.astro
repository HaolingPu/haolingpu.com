---
import { cn } from "@lib/utils";

/**
 * Vertical-rhythm block with an optional mono eyebrow, heading and
 * right-aligned action (e.g. "See all →").
 */
type Props = { eyebrow?: string; title?: string; class?: string; id?: string };
const { eyebrow, title, class: className, id } = Astro.props;
---

<section id={id} class={cn("py-10 sm:py-14", className)}>
  {
    (eyebrow || title || Astro.slots.has("action")) && (
      <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <div>
          {eyebrow && (
            <div class="mb-1 font-mono text-xs uppercase tracking-[0.12em] text-fg-subtle">
              {eyebrow}
            </div>
          )}
          {title && <h2 class="text-xl">{title}</h2>}
        </div>
        {Astro.slots.has("action") && (
          <div class="text-sm">
            <slot name="action" />
          </div>
        )}
      </div>
    )
  }
  <slot />
</section>
