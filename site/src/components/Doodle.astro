---
/** Small line illustrations beside roles and projects. Monochrome strokes; the accent marks the point. */
export type DoodleName =
  | "wiki-agent"
  | "simulst"
  | "warm-pool"
  | "prenatal"
  | "flight-data"
  | "sparse-attn"
  | "self-wiki"
  | "hybrid-rag"
  | "photo-restore"
  | "pet"
  | "future"
  | "kernel";
type Props = { name: DoodleName; class?: string };
const { name, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 96 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["text-fg-subtle", className]}
  aria-hidden="true"
>
  {name === "wiki-agent" && (
    <>
      <rect x="6" y="14" width="18" height="24" rx="2" /><path d="M10 20h10M10 25h10M10 30h6" />
      <rect x="4" y="22" width="18" height="24" rx="2" class="fill-bg" /><path d="M8 28h10M8 33h10M8 38h6" />
      <path d="M26 32h10" /><path d="m33 29 3 3-3 3" />
      <circle cx="48" cy="32" r="9" /><circle cx="45" cy="30" r="1.2" fill="currentColor" /><circle cx="51" cy="30" r="1.2" fill="currentColor" /><path d="M45 35c2 2 4 2 6 0" /><path d="M48 23v-4" /><circle cx="48" cy="17" r="1.5" class="stroke-accent" />
      <path d="M60 32h10" /><path d="m67 29 3 3-3 3" />
      <rect x="74" y="18" width="18" height="28" rx="2" /><path d="M78 24h10M78 29h10M78 34h10M78 39h6" class="stroke-accent" />
    </>
  )}
  {name === "simulst" && (
    <>
      <path d="M6 32c3 0 3-10 6-10s3 20 6 20 3-14 6-14 3 8 6 8 3-6 6-6 3 4 6 4" />
      <path d="M46 32h8" /><path d="m51 29 3 3-3 3" />
      <rect x="58" y="22" width="32" height="20" rx="4" />
      <path d="M64 30h10M64 35h6" /><path d="M78 32h2M82 32h2M86 32h2" class="stroke-accent" />
      <path d="M40 14v36" stroke-dasharray="2 3" class="stroke-accent" />
    </>
  )}
  {name === "warm-pool" && (
    <>
      <rect x="8" y="34" width="80" height="18" rx="4" /><path d="M14 43c4-3 8-3 12 0s8 3 12 0 8-3 12 0 8 3 12 0 8-3 12 0" class="stroke-accent" />
      <rect x="18" y="20" width="14" height="10" rx="2" /><rect x="41" y="20" width="14" height="10" rx="2" /><rect x="64" y="20" width="14" height="10" rx="2" />
      <path d="M25 16v-4M48 16v-4M71 16v-4" class="stroke-accent" /><path d="M23 12c2-2 2-2 4 0M46 12c2-2 2-2 4 0M69 12c2-2 2-2 4 0" class="stroke-accent" />
    </>
  )}
  {name === "prenatal" && (
    <>
      <rect x="30" y="8" width="36" height="50" rx="6" /><path d="M42 12h12" />
      <path d="M48 44c-8-6-12-10-12-16a6 6 0 0 1 12-2 6 6 0 0 1 12 2c0 6-4 10-12 16z" class="stroke-accent" />
      <path d="M40 50h16" />
    </>
  )}
  {name === "flight-data" && (
    <>
      <path d="M10 40 34 28l-2-14 4-2 8 14 18-8 4 2-14 14 2 12-4 2-6-10-14 8z" />
      <path d="M58 44h30M58 50h22M58 38h26" class="stroke-accent" stroke-dasharray="3 3" />
    </>
  )}
  {name === "sparse-attn" && (
    <>
      <rect x="18" y="8" width="60" height="48" rx="2" />
      <path d="M30 8v48M42 8v48M54 8v48M66 8v48M18 20h60M18 32h60M18 44h60" stroke-width="1" opacity=".6" />
      <rect x="18" y="8" width="12" height="12" class="fill-accent stroke-accent" opacity=".85" /><rect x="30" y="20" width="12" height="12" class="fill-accent stroke-accent" opacity=".85" /><rect x="42" y="32" width="12" height="12" class="fill-accent stroke-accent" opacity=".85" /><rect x="54" y="44" width="12" height="12" class="fill-accent stroke-accent" opacity=".85" /><rect x="66" y="44" width="12" height="12" class="fill-accent stroke-accent" opacity=".5" /><rect x="18" y="44" width="12" height="12" class="fill-accent stroke-accent" opacity=".5" />
    </>
  )}
  {name === "self-wiki" && (
    <>
      <circle cx="22" cy="20" r="7" /><circle cx="60" cy="14" r="7" /><circle cx="76" cy="40" r="7" /><circle cx="40" cy="48" r="7" class="stroke-accent" /><circle cx="48" cy="30" r="5" />
      <path d="M28 23l15 5M55 19l-3 7M52 33l17 5M45 34l-3 8M47 25l9-7M34 46l-9-20" />
    </>
  )}
  {name === "hybrid-rag" && (
    <>
      <path d="M8 14h28l-10 14v14l-8 4V28z" /><path d="M60 14h28l-10 14v14l-8 4V28z" />
      <path d="M22 46v6h52v-6" /><path d="M48 52v6" class="stroke-accent" /><circle cx="48" cy="60" r="2" class="fill-accent stroke-accent" />
    </>
  )}
  {name === "photo-restore" && (
    <>
      <rect x="14" y="12" width="68" height="44" rx="3" />
      <path d="M48 12v44" stroke-dasharray="3 3" />
      <path d="M20 46l10-12 8 8 6-6 4 10" opacity=".5" /><circle cx="26" cy="22" r="3" opacity=".5" />
      <path d="M52 46l10-12 8 8 6-6 4 10" class="stroke-accent" /><circle cx="58" cy="22" r="3" class="stroke-accent fill-accent" />
    </>
  )}
  {name === "pet" && (
    <>
      <ellipse cx="48" cy="42" rx="12" ry="9" /><circle cx="34" cy="26" r="5" /><circle cx="44" cy="18" r="5" /><circle cx="56" cy="18" r="5" /><circle cx="66" cy="26" r="5" />
      <circle cx="78" cy="46" r="8" class="stroke-accent" /><path d="M84 52l6 6" class="stroke-accent" />
    </>
  )}
  {name === "future" && (
    <>
      <path d="M8 40h40" /><circle cx="48" cy="40" r="3" class="fill-accent stroke-accent" />
      <path d="M51 38c10-6 18-12 30-14M51 40h30M51 42c10 6 18 12 30 14" stroke-dasharray="3 3" />
      <path d="M78 22l4 2-2 4M78 40l4 0-2 3M78 54l4-2-2-4" />
    </>
  )}
  {name === "kernel" && (
    <>
      <rect x="28" y="20" width="40" height="24" rx="3" /><path d="M36 20v-6M48 20v-6M60 20v-6M36 44v6M48 44v6M60 44v6M28 28h-6M28 36h-6M68 28h6M68 36h6" />
      <path d="M40 32h16" class="stroke-accent" /><path d="m52 29 4 3-4 3" class="stroke-accent" />
    </>
  )}
</svg>
