---
import CmuWordmark from "@components/logos/CmuWordmark.astro";
import UmichLogo from "@components/logos/UmichLogo.astro";
import Tag from "@components/ui/Tag.astro";
import type { Education } from "@types";

type Props = { edu: Education };
const { edu } = Astro.props;
---

<a
  href={edu.URL}
  target="_blank"
  rel="noopener noreferrer"
  data-tilt="5"
  class="tilt group relative block rounded-lg border border-border bg-surface p-6 text-fg-muted transition-[border-color] duration-200 ease-out-quart hover:border-border-strong"
>
  <div class="tilt-glare" aria-hidden="true"></div>
  <div class="flex h-9 items-center text-fg-subtle transition-colors duration-200 group-hover:text-fg">
    {edu.LOGO === "cmu" ? <CmuWordmark class="h-[15px] w-auto" /> : <UmichLogo class="h-9 w-auto" />}
  </div>
  <div class="mt-5 text-lg font-medium text-fg">{edu.DEGREE}</div>
  <div class="mt-1 text-sm">{edu.UNIT} · {edu.LOCATION}</div>
  <dl class="mt-4 grid grid-cols-2 gap-x-6 font-mono text-xs">
    <div>
      <dt class="text-fg-subtle">dates</dt>
      <dd class="text-fg">{edu.START} – {edu.END}</dd>
    </div>
    <div>
      <dt class="text-fg-subtle">gpa</dt>
      <dd class="text-fg">{edu.GPA}</dd>
    </div>
  </dl>
  <div class="mt-5 flex flex-wrap gap-1.5">
    {edu.COURSES.map((c) => <Tag>{c}</Tag>)}
  </div>
</a>
