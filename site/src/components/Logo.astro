---
/**
 * Small organization mark used beside roles, projects and research.
 * Official marks (Google, NVIDIA, Michigan) are inlined from Wikimedia Commons
 * for factual-affiliation use; organizations without a public vector mark get
 * a colored initial tile so every row still gets a picture.
 */
export type LogoName = "google" | "nvidia" | "cmu" | "umich" | "weride" | "umsn" | "aviage";
type Props = { name: LogoName; class?: string; size?: number };
const { name, class: className, size = 22 } = Astro.props;

const initials: Record<string, { text: string; bg: string; fg: string }> = {
  cmu: { text: "CMU", bg: "#ab1727", fg: "#fff" },
  weride: { text: "W", bg: "#1f2a44", fg: "#fff" },
  aviage: { text: "A", bg: "#0b5fa5", fg: "#fff" },
};
const labels: Record<LogoName, string> = {
  google: "Google",
  nvidia: "NVIDIA",
  cmu: "Carnegie Mellon University",
  umich: "University of Michigan",
  weride: "WeRide",
  umsn: "University of Michigan School of Nursing",
  aviage: "AVIAGE Systems",
};
---

<span
  class:list={[
    "inline-flex shrink-0 items-center justify-center overflow-hidden rounded-[6px] border border-border bg-white align-[-5px]",
    className,
  ]}
  style={`width:${size + 6}px;height:${size + 6}px`}
  role="img"
  aria-label={labels[name]}
  title={labels[name]}
>
  {
    name === "google" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size - 4} height={size - 4}>
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
      </svg>
    )
  }
  {
    name === "nvidia" && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 30" width={size} height={size * 0.65}>
        <path
          d="M16.889,8.985L16.889,6.28C17.151,6.26 17.417,6.247 17.687,6.238C25.087,6.006 29.942,12.597 29.942,12.597C29.942,12.597 24.698,19.879 19.076,19.879C18.333,19.882 17.594,19.764 16.889,19.529L16.889,11.325C19.769,11.673 20.349,12.945 22.081,15.833L25.933,12.585C25.933,12.585 23.121,8.897 18.381,8.897C17.866,8.897 17.373,8.933 16.889,8.985ZM16.889,0.047L16.889,4.09C17.154,4.069 17.42,4.052 17.687,4.042C27.977,3.696 34.682,12.482 34.682,12.482C34.682,12.482 26.982,21.846 18.959,21.846C18.224,21.846 17.535,21.778 16.889,21.663L16.889,24.161C17.442,24.231 18.015,24.273 18.613,24.273C26.078,24.273 31.477,20.461 36.705,15.948C37.572,16.642 41.121,18.331 41.85,19.071C36.879,23.231 25.295,26.586 18.727,26.586C18.113,26.584 17.5,26.552 16.889,26.49L16.889,30L45.264,30L45.264,0.047L16.889,0.047ZM16.889,19.529L16.889,21.662C9.984,20.432 8.067,13.254 8.067,13.254C8.067,13.254 11.383,9.58 16.889,8.985L16.889,11.325L16.878,11.324C13.988,10.977 11.731,13.677 11.731,13.677C11.731,13.677 12.996,18.221 16.889,19.529ZM4.625,12.943C4.625,12.943 8.717,6.903 16.889,6.28L16.889,4.088C7.838,4.815 0,12.48 0,12.48C0,12.48 4.439,25.313 16.889,26.488L16.889,24.16C7.753,23.011 4.625,12.943 4.625,12.943Z"
          fill="#76b900"
        />
      </svg>
    )
  }
  {
    (name === "umich" || name === "umsn") && (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 294.32812 212.39062" width={size - 2} height={(size - 2) * 0.72}>
        <g transform="matrix(1.25 0 0 -1.25 -123.87 786.33)">
          <g transform="matrix(2.5 0 0 2.5 -323.12 -814.35)">
            <path d="m234.43 576.97-18.42-25.467-18.389 25.467h-28.368v-20.011h7.027v-27.304h-7.027v-20.01h36.173v20.01h-7.495v15.67l17.982-24.726 18.207 24.747v-15.691h-7.495v-20.01h36.173v20.01h-7.027v27.304h7.027v20.011h-28.368z" fill="#00274c" />
            <path d="m261.29 558.47v16.998h-26.092l-19.191-26.532-19.157 26.532h-26.092v-16.998h7.027v-30.317h-7.027v-16.998h33.161v16.998h-7.496v21.807l19.495-26.806 19.707 26.785v-21.786h-7.495v-16.998h33.16v16.998h-7.027v30.317h7.027" fill="#f5c300" />
          </g>
        </g>
      </svg>
    )
  }
  {
    initials[name] && (
      <span
        class="flex size-full items-center justify-center font-mono font-bold leading-none tracking-tight"
        style={`background:${initials[name].bg};color:${initials[name].fg};font-size:${initials[name].text.length > 1 ? size * 0.36 : size * 0.6}px`}
      >
        {initials[name].text}
      </span>
    )
  }
</span>
