---
import type { CollectionEntry } from "astro:content";
import Tag from "@components/ui/Tag.astro";

type Props = { project: CollectionEntry<"projects">; class?: string };
const { project, class: className } = Astro.props;
const { title, summary, tags, context, repo, private: isPrivate } = project.data;
---

<a
  href={`/projects/${project.id}`}
  data-tags={tags.join(" ")}
  class:list={[
    "group relative flex h-full flex-col rounded-lg border border-border bg-surface p-5",
    "transition-[border-color,transform] duration-200 ease-out-quart hover:-translate-y-px hover:border-border-strong",
    className,
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div class="font-medium text-fg">{title}</div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="mt-1 size-4 shrink-0 fill-none stroke-current stroke-2 text-fg-subtle transition-[color,transform] duration-200 ease-out-quart group-hover:translate-x-0.5 group-hover:text-accent"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
  {context && <div class="mt-1 font-mono text-xs text-fg-subtle">{context}</div>}
  <p class="mt-3 flex-1 text-sm">{summary}</p>
  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    {tags.map((t) => <Tag>{t}</Tag>)}
    {repo && <Tag accent>open source</Tag>}
    {isPrivate && <Tag>code private</Tag>}
  </div>
</a>
