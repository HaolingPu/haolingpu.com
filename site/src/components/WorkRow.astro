---
import type { CollectionEntry } from "astro:content";
import Doodle from "@components/Doodle.astro";
import Logo from "@components/Logo.astro";
import { dateRange } from "@lib/utils";
import type { Lang } from "@site.config";

type Props = { entry: CollectionEntry<"work">; compact?: boolean; lang?: Lang };
const { entry, compact = false, lang = "en" } = Astro.props;
const d = entry.data;
const role = lang === "zh" && d.role_zh ? d.role_zh : d.role;
const highlights = lang === "zh" && d.highlights_zh ? d.highlights_zh : d.highlights;
---

<li class="grid gap-1 py-4 sm:grid-cols-[150px_1fr_auto] sm:gap-6">
  <div class="pt-[3px] font-mono text-[12.5px] text-fg-subtle">{dateRange(d.dateStart, d.dateEnd === "Present" && lang === "zh" ? "至今" : d.dateEnd)}</div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-2">
      {d.logo && <Logo name={d.logo} class="mr-0.5" />}
      <span class="font-medium">{role}</span>
      <span class="text-fg-subtle">·</span>
      {
        d.url ? (
          <a href={d.url} target="_blank" rel="noopener noreferrer" class="link">{d.company}</a>
        ) : (
          <span>{d.company}</span>
        )
      }
      <span class="text-sm text-fg-subtle">{d.location}</span>
    </div>
    <p class="mt-1 max-w-[46rem] text-[15px] leading-relaxed text-fg-muted">
      {compact ? highlights[0] : highlights.join(" ")}
    </p>
  </div>
  {d.doodle && <Doodle name={d.doodle} class="hidden h-16 w-24 shrink-0 sm:block" />}
</li>
