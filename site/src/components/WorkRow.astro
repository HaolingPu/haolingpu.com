---
import type { CollectionEntry } from "astro:content";
import { dateRange } from "@lib/utils";

type Props = { entry: CollectionEntry<"work">; compact?: boolean };
const { entry, compact = false } = Astro.props;
const d = entry.data;
---

<li class="grid gap-1 py-3 sm:grid-cols-[150px_1fr] sm:gap-6">
  <div class="pt-[3px] font-mono text-[12.5px] text-fg-subtle">{dateRange(d.dateStart, d.dateEnd)}</div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-medium">{d.role}</span>
      <span class="text-fg-subtle">·</span>
      {
        d.url ? (
          <a href={d.url} target="_blank" rel="noopener noreferrer" class="link">{d.company}</a>
        ) : (
          <span>{d.company}</span>
        )
      }
      <span class="text-sm text-fg-subtle">{d.location}</span>
    </div>
    {
      compact ? (
        <p class="mt-0.5 text-[15px] leading-relaxed text-fg-muted">{d.highlights[0]}</p>
      ) : (
        <ul class="mt-1.5 list-disc space-y-1 pl-5 text-[15px] leading-relaxed text-fg-muted marker:text-border-strong">
          {d.highlights.map((h) => <li>{h}</li>)}
        </ul>
      )
    }
    {
      !compact && d.tech.length > 0 && (
        <div class="mt-2 font-mono text-[12px] text-fg-subtle">{d.tech.join(" · ")}</div>
      )
    }
  </div>
</li>
