---
import type { CollectionEntry } from "astro:content";
import Tag from "@components/ui/Tag.astro";
import { dateRange } from "@lib/utils";

type Props = { entry: CollectionEntry<"work">; compact?: boolean };
const { entry, compact = false } = Astro.props;
const d = entry.data;
---

<div class="group grid gap-2 sm:grid-cols-[140px_1fr] sm:gap-8">
  <div class="pt-0.5 font-mono text-xs text-fg-subtle">{dateRange(d.dateStart, d.dateEnd)}</div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-medium text-fg">{d.role}</span>
      <span class="text-fg-subtle">·</span>
      {
        d.url ? (
          <a href={d.url} target="_blank" rel="noopener noreferrer" class="text-fg-muted underline decoration-border-strong underline-offset-4 transition-colors hover:text-fg hover:decoration-accent">
            {d.company}
          </a>
        ) : (
          <span class="text-fg-muted">{d.company}</span>
        )
      }
    </div>
    <div class="mt-0.5 text-sm text-fg-subtle">{d.location}</div>
    <ul class:list={["mt-3 space-y-1.5 text-sm", compact && "hidden sm:block"]}>
      {(compact ? d.highlights.slice(0, 2) : d.highlights).map((h) => <li class="flex gap-2"><span class="mt-[9px] size-1 shrink-0 rounded-full bg-border-strong" /><span>{h}</span></li>)}
    </ul>
    {
      !compact && d.tech.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {d.tech.map((t) => <Tag>{t}</Tag>)}
        </div>
      )
    }
  </div>
</div>
