---
import type { CollectionEntry } from "astro:content";
import Doodle from "@components/Doodle.astro";
import Logo from "@components/Logo.astro";

import type { Lang } from "@site.config";

type Props = { project: CollectionEntry<"projects">; lang?: Lang };
const { project, lang = "en" } = Astro.props;
const d = project.data;
const title = lang === "zh" && d.title_zh ? d.title_zh : d.title;
const summary = lang === "zh" && d.summary_zh ? d.summary_zh : d.summary;
const { context, repo, private: isPrivate, logo, doodle } = d;
---

<li class="flex items-start gap-6 py-4">
  <div class="min-w-0 flex-1">
  <div class="flex flex-wrap items-baseline gap-x-2">
    {logo && <Logo name={logo} class="mr-0.5" />}
    <a href={`${lang === "zh" ? "/zh" : ""}/projects/${project.id}`} class="link font-medium">{title}</a>
    {context && <span class="text-sm text-fg-subtle">· {context}</span>}
    {repo && <a href={repo} target="_blank" rel="noopener noreferrer" class="link-quiet text-sm">{lang === "zh" ? "代码" : "code"} ↗</a>}
    {isPrivate && !repo && <span class="text-sm text-fg-subtle">· {lang === "zh" ? "代码未公开" : "code private"}</span>}
  </div>
  <p class="mt-1 max-w-[46rem] text-[15px] leading-relaxed text-fg-muted">{summary}</p>
  </div>
  {doodle && <Doodle name={doodle} class="hidden h-16 w-24 shrink-0 sm:block" />}
</li>
