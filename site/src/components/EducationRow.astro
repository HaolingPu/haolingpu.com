---
import CmuWordmark from "@components/logos/CmuWordmark.astro";
import UmichLogo from "@components/logos/UmichLogo.astro";
import type { Education } from "@types";

type Props = { edu: Education; compact?: boolean };
const { edu, compact = false } = Astro.props;
---

<li class="group grid gap-1 py-3 sm:grid-cols-[150px_1fr] sm:gap-6">
  <div class="pt-[3px] font-mono text-[12.5px] text-fg-subtle">{edu.START} – {edu.END}</div>
  <div>
    <div class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-medium">{edu.DEGREE}</span>
      <span class="text-fg-subtle">·</span>
      <a href={edu.URL} target="_blank" rel="noopener noreferrer" class="link">{edu.SCHOOL}</a>
    </div>
    <div class="mt-0.5 text-[15px] text-fg-muted">
      {edu.UNIT} · GPA {edu.GPA}
    </div>
    {!compact && <div class="mt-1.5 text-[14px] text-fg-subtle">Coursework: {edu.COURSES.join(", ")}</div>}
    <div class="mt-2.5 flex h-6 items-center text-fg-subtle/80 transition-colors group-hover:text-fg">
      {edu.LOGO === "cmu" ? <CmuWordmark class="h-[11px] w-auto" /> : <UmichLogo class="h-6 w-auto" />}
    </div>
  </div>
</li>
