---
import Container from "@components/ui/Container.astro";
import Link from "@components/ui/Link.astro";
import { REPO_URL, SITE, SOCIALS } from "@site.config";

/* Evaluated at build time on Vercel, so this is the deploy date. */
const built = new Date().toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<footer class="site-footer animate border-t border-border">
  <Container size="wide">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-2">
        <div class="text-fg">{SITE.NAME}</div>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {
            SOCIALS.map((s) => (
              <li>
                <Link href={s.HREF} external underline={false} class="text-fg-muted">
                  {s.NAME}
                </Link>
              </li>
            ))
          }
          <li>
            <Link href={`mailto:${SITE.EMAIL}`} underline={false} class="text-fg-muted">
              email
            </Link>
          </li>
        </ul>
      </div>
      <div class="font-mono text-xs text-fg-subtle sm:text-right">
        <div>
          built with <Link href="https://astro.build" external underline={false}>astro</Link>
          {" · "}
          <Link href={REPO_URL} external underline={false}>source</Link>
        </div>
        <div class="mt-1">last deployed {built}</div>
      </div>
    </div>
  </Container>
</footer>
