---
import Container from "@components/ui/Container.astro";
import Link from "@components/ui/Link.astro";
import { SITE, SOCIALS } from "@site.config";
---

<footer class="site-footer animate border-t border-border">
  <Container size="wide">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-2">
        <div class="text-fg">{SITE.NAME}</div>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {
            SOCIALS.map((s) => (
              <li>
                <Link href={s.HREF} external underline={false} class="text-fg-muted">
                  {s.NAME}
                </Link>
              </li>
            ))
          }
          <li>
            <Link href={`mailto:${SITE.EMAIL}`} underline={false} class="text-fg-muted">
              email
            </Link>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</footer>
