---
import { Image } from "astro:assets";
import michigan from "@assets/photos/michigan-union.jpg";
import type { Lang } from "@site.config";

/**
 * Campus photos under the education list: a two-up row, one per school.
 * To add a school, drop the file in @assets/photos and add an entry here.
 */
type Props = { lang?: Lang };
const { lang = "en" } = Astro.props;
const zh = lang === "zh";

const photos = [
  {
    src: michigan,
    alt: zh
      ? "穿着学位服坐在 Michigan Union 标牌上，安娜堡，2025 年 5 月"
      : "Sitting on the Michigan Union sign in cap and gown, Ann Arbor, May 2025",
    caption: zh ? "Michigan Union，安娜堡 · 2025 年 5 月" : "Michigan Union, Ann Arbor · May 2025",
  },
];
---

<ul class="mt-5 grid gap-4 sm:grid-cols-2">
  {
    photos.map((p) => (
      <li>
        <figure>
          <Image
            src={p.src}
            alt={p.alt}
            widths={[460, 920]}
            sizes="(min-width: 640px) 460px, 100vw"
            class="aspect-[5/4] w-full rounded-lg border border-border object-cover"
          />
          <figcaption class="mt-2 font-mono text-[12px] text-fg-subtle">{p.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>
