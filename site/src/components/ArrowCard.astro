---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="group relative flex flex-nowrap rounded-lg border border-border bg-surface py-3 px-4 pr-10 transition-[border-color,transform] duration-200 ease-out-quart hover:-translate-y-px hover:border-border-strong"
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-medium text-fg">{entry.data.title}</div>
    <div class="text-sm">{entry.data.description}</div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-3 size-4 -translate-y-1/2 fill-none stroke-current stroke-2 text-fg-subtle transition-[color,transform] duration-200 ease-out-quart group-hover:translate-x-0.5 group-hover:text-accent"
  >
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 19 12 12 19"></polyline>
  </svg>
</a>
