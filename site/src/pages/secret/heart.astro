---
import Head from "@components/Head.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title="♡" description="For someone." noindex />
    <style>
      html, body { height: 100%; margin: 0; }
      body.heart {
        overflow: hidden; background: #06030d; color: #f4c6d6;
        font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", Georgia, serif;
        touch-action: none; user-select: none; -webkit-user-select: none;
      }
      canvas.stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
      .hud { position: fixed; inset: 0; pointer-events: none; }
      .hint {
        position: absolute; left: 0; right: 0; bottom: 22px; text-align: center;
        font: 12px/1.6 ui-monospace, Menlo, monospace; letter-spacing: 0.14em; color: rgba(244, 198, 214, 0.55);
        opacity: 0; animation: fade 1.2s ease 2.4s forwards;
      }
      .back {
        position: absolute; left: 18px; top: 16px; font: 13px/1 ui-monospace, monospace;
        color: rgba(244, 198, 214, 0.55); text-decoration: none; pointer-events: auto;
      }
      .back:hover { color: #fff; }
      .fallback {
        position: absolute; inset: 0; display: grid; place-items: center; text-align: center;
        transition: opacity 900ms ease;
      }
      .fallback .n { font-size: clamp(56px, 14vw, 150px); font-weight: 600; letter-spacing: 0.08em; color: #ff7aa8;
        text-shadow: 0 0 40px rgba(255, 90, 140, 0.55); }
      .fallback .s { margin-top: 18px; font: 12px/1.6 ui-monospace, monospace; letter-spacing: 0.2em; color: rgba(244,198,214,.55); }
      .fallback.hide { opacity: 0; pointer-events: none; }
      .hint { opacity: 1; animation: none; }
      body.ready .hint { animation: none; }
    </style>
  </head>
  <body class="heart">
    <canvas class="stage" aria-label="(her name)" role="img"></canvas>
    <div class="hud">
      <a class="back" href="/">← back</a>
      <div class="fallback" data-fallback>
        <div>
          <div class="n">(her name)</div>
          <div class="s" data-fallback-msg>loading ♡</div>
        </div>
      </div>
      <div class="hint">tap · name ⇄ heart &nbsp;&nbsp; drag · rotate</div>
    </div>

    <script>
      import * as THREE from "three";
      import { EffectComposer } from "three/addons/postprocessing/EffectComposer.js";
      import { RenderPass } from "three/addons/postprocessing/RenderPass.js";
      import { UnrealBloomPass } from "three/addons/postprocessing/UnrealBloomPass.js";
      import { OutputPass } from "three/addons/postprocessing/OutputPass.js";

      // Gate: only reachable after answering the question in this session.
      if (sessionStorage.getItem("door") !== "open") {
        window.location.replace("/secret/");
      }

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const small = Math.min(window.innerWidth, window.innerHeight) < 640;
      const COUNT = small ? 7000 : 11000;
      const NAME = "(her name)";

      // ---------- renderer / scene ----------
      const canvas = document.querySelector<HTMLCanvasElement>("canvas.stage")!;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: "high-performance" });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.set(0, 0, small ? 4.4 : 3.6);

      const composer = new EffectComposer(renderer);
      composer.addPass(new RenderPass(scene, camera));
      const bloom = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 0.8, 0.5, 0.3);
      composer.addPass(bloom);
      composer.addPass(new OutputPass());

      // ---------- heart surface sampling (Taubin's heart) ----------
      // f(x,y,z) = (x² + 9/4·y² + z² − 1)³ − x²·z³ − 9/80·y²·z³ ; z is "up" here, swapped to Y for three.js.
      function heartF(x: number, y: number, z: number) {
        const a = x * x + 2.25 * y * y + z * z - 1;
        return a * a * a - x * x * z * z * z - 0.1125 * y * y * z * z * z;
      }
      const heartPos = new Float32Array(COUNT * 3);
      {
        let i = 0;
        while (i < COUNT) {
          const x = (Math.random() * 2 - 1) * 1.35;
          const y = (Math.random() * 2 - 1) * 0.95; // depth
          const z = (Math.random() * 2 - 1) * 1.35; // up
          const f = heartF(x, y, z);
          // shell (|f| small) plus a sparse interior for volume
          if (Math.abs(f) < 0.02 || (f < 0 && Math.random() < 0.02)) {
            heartPos[i * 3] = x;
            heartPos[i * 3 + 1] = z - 0.15;
            heartPos[i * 3 + 2] = y;
            i++;
          }
        }
      }

      // ---------- name sampling (text → points) ----------
      function sampleText(text: string, n: number) {
        const W = 720;
        const H = 300;
        const c = document.createElement("canvas");
        c.width = W;
        c.height = H;
        const g = c.getContext("2d")!;
        g.fillStyle = "#000";
        g.fillRect(0, 0, W, H);
        g.fillStyle = "#fff";
        g.textAlign = "center";
        g.textBaseline = "middle";
        g.font = `700 200px "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", serif`;
        g.fillText(text, W / 2, H / 2 + 8);
        const px = g.getImageData(0, 0, W, H).data;
        const pts: number[] = [];
        for (let y = 0; y < H; y += 2) {
          for (let x = 0; x < W; x += 2) {
            if (px[(y * W + x) * 4] > 128) pts.push(x, y);
          }
        }
        const out = new Float32Array(n * 3);
        const m = pts.length / 2;
        const sx = 3.4 / W;
        for (let i = 0; i < n; i++) {
          const k = Math.floor(Math.random() * m);
          out[i * 3] = (pts[k * 2] - W / 2) * sx + (Math.random() - 0.5) * 0.01;
          out[i * 3 + 1] = -(pts[k * 2 + 1] - H / 2) * sx + (Math.random() - 0.5) * 0.01;
          out[i * 3 + 2] = (Math.random() - 0.5) * 0.12;
        }
        return out;
      }
      const textPos = sampleText(NAME, COUNT);

      const rand = new Float32Array(COUNT);
      const delay = new Float32Array(COUNT);
      for (let i = 0; i < COUNT; i++) {
        rand[i] = Math.random();
        delay[i] = Math.random();
      }

      // ---------- particles ----------
      const geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.BufferAttribute(heartPos, 3));
      geo.setAttribute("aText", new THREE.BufferAttribute(textPos, 3));
      geo.setAttribute("aRand", new THREE.BufferAttribute(rand, 1));
      geo.setAttribute("aDelay", new THREE.BufferAttribute(delay, 1));

      const uniforms = {
        uTime: { value: 0 },
        uMix: { value: 0 }, // 0 = heart, 1 = name
        uBeat: { value: 1 },
        uSize: { value: small ? 17 : 15 },
        uPixelRatio: { value: renderer.getPixelRatio() },
      };
      const mat = new THREE.ShaderMaterial({
        uniforms,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: /* glsl */ `
          attribute vec3 aText;
          attribute float aRand;
          attribute float aDelay;
          uniform float uTime, uMix, uBeat, uSize, uPixelRatio;
          varying vec3 vColor;
          varying float vTwinkle;
          void main() {
            // staggered morph
            float t = smoothstep(0.0, 1.0, clamp((uMix - aDelay * 0.35) / 0.65, 0.0, 1.0));
            vec3 heart = position * uBeat;
            vec3 p = mix(heart, aText, t);
            // gentle drift so it never looks frozen
            float dr = (1.0 - 0.6 * t) * 0.018;
            p += dr * vec3(sin(uTime * 1.3 + aRand * 6.2831), cos(uTime * 1.1 + aRand * 3.1), sin(uTime * 0.9 + aRand * 9.4));
            vec4 mv = modelViewMatrix * vec4(p, 1.0);
            gl_Position = projectionMatrix * mv;
            float tw = 0.75 + 0.25 * sin(uTime * 2.6 + aRand * 40.0);
            vTwinkle = tw;
            gl_PointSize = uSize * (0.45 + 0.9 * aRand) * tw * uPixelRatio / -mv.z;
            // color: deep rose core → pale pink edge, warmer when it's the name
            float r = length(position.xy);
            vec3 rose = vec3(1.0, 0.22, 0.48);
            vec3 pale = vec3(1.0, 0.72, 0.84);
            vec3 gold = vec3(1.0, 0.86, 0.72);
            vColor = mix(mix(rose, pale, smoothstep(0.2, 1.3, r) * 0.8), gold, t * 0.35);
          }
        `,
        fragmentShader: /* glsl */ `
          varying vec3 vColor;
          varying float vTwinkle;
          void main() {
            float d = length(gl_PointCoord - 0.5);
            float a = smoothstep(0.5, 0.05, d);
            gl_FragColor = vec4(vColor * (0.8 + 0.3 * vTwinkle), a * 0.5);
          }
        `,
      });
      const cloud = new THREE.Points(geo, mat);
      const group = new THREE.Group();
      group.add(cloud);
      group.scale.setScalar(0.9);
      scene.add(group);

      // ---------- stars ----------
      {
        const n = 1600;
        const p = new Float32Array(n * 3);
        for (let i = 0; i < n; i++) {
          const r = 14 + Math.random() * 26;
          const th = Math.random() * Math.PI * 2;
          const ph = Math.acos(Math.random() * 2 - 1);
          p[i * 3] = r * Math.sin(ph) * Math.cos(th);
          p[i * 3 + 1] = r * Math.sin(ph) * Math.sin(th);
          p[i * 3 + 2] = r * Math.cos(ph);
        }
        const sg = new THREE.BufferGeometry();
        sg.setAttribute("position", new THREE.BufferAttribute(p, 3));
        const sm = new THREE.PointsMaterial({ color: 0x9fb0d8, size: 0.06, transparent: true, opacity: 0.55, depthWrite: false });
        scene.add(new THREE.Points(sg, sm));
      }

      // ---------- interaction: drag to rotate, tap to morph ----------
      let mode = 0; // 0 heart, 1 name
      let mixTarget = 0;
      let rotVel = 0;
      let dragging = false;
      let moved = 0;
      let lastX = 0;
      let lastY = 0;
      let tiltX = 0;
      let tiltTarget = 0;

      canvas.addEventListener("pointerdown", (e) => {
        dragging = true;
        moved = 0;
        lastX = e.clientX;
        lastY = e.clientY;
        canvas.setPointerCapture(e.pointerId);
      });
      canvas.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        moved += Math.abs(dx) + Math.abs(dy);
        lastX = e.clientX;
        lastY = e.clientY;
        rotVel = dx * 0.004;
        group.rotation.y += rotVel;
        tiltTarget = THREE.MathUtils.clamp(tiltTarget + dy * 0.003, -0.6, 0.6);
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        if (moved < 6) {
          mode = 1 - mode;
          mixTarget = mode;
        }
      };
      canvas.addEventListener("pointerup", endDrag);
      canvas.addEventListener("pointercancel", endDrag);

      window.addEventListener("resize", () => {
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
      });

      // ---------- loop ----------
      const clock = new THREE.Clock();
      let running = true;
      document.addEventListener("visibilitychange", () => {
        running = !document.hidden;
        if (running) frame();
      });

      function beat(t: number) {
        // lub-dub at ~66 bpm
        const ph = (t * 1.1) % 1;
        const lub = Math.pow(Math.max(0, Math.sin(ph * Math.PI * 2)), 10);
        const dub = Math.pow(Math.max(0, Math.sin((ph - 0.22) * Math.PI * 2)), 10) * 0.55;
        return lub + dub;
      }

      function frame() {
        if (!running) return;
        const t = clock.getElapsedTime();
        uniforms.uTime.value = t;
        uniforms.uMix.value += (mixTarget - uniforms.uMix.value) * 0.045;
        uniforms.uBeat.value = reduced ? 1 : 1 + 0.07 * beat(t) * (1 - uniforms.uMix.value);

        if (!dragging) {
          if (mode === 0) {
            group.rotation.y += reduced ? 0 : 0.0035 + rotVel;
            rotVel *= 0.94;
          } else {
            // face the camera for the name
            const target = Math.round(group.rotation.y / (Math.PI * 2)) * Math.PI * 2;
            group.rotation.y += (target - group.rotation.y) * 0.06;
            tiltTarget *= 0.9;
          }
        }
        tiltX += (tiltTarget - tiltX) * 0.08;
        group.rotation.x = tiltX;

        composer.render();
        requestAnimationFrame(frame);
      }
      let firstFrame = true;
      const origRender = composer.render.bind(composer);
      composer.render = (...args: Parameters<typeof origRender>) => {
        origRender(...args);
        if (firstFrame) {
          firstFrame = false;
          document.querySelector("[data-fallback]")?.classList.add("hide");
        }
      };
      frame();
    </script>
    <script is:inline>
      // If the 3D scene never starts (no WebGL, blocked script, in-app browser), keep the plain name on screen.
      setTimeout(() => {
        const fb = document.querySelector("[data-fallback]");
        const msg = document.querySelector("[data-fallback-msg]");
        if (fb && !fb.classList.contains("hide") && msg) {
          msg.textContent = "你是我最喜欢的 · (3D needs a browser with WebGL — try Safari or Chrome)";
        }
      }, 6000);
      window.addEventListener("error", () => {
        const msg = document.querySelector("[data-fallback-msg]");
        if (msg) msg.textContent = "你是我最喜欢的";
      });
    </script>
  </body>
</html>
