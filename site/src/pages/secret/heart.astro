---
import Head from "@components/Head.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title="♡" description="For someone." noindex />
    <style>
      html, body { height: 100%; margin: 0; }
      body.heart {
        overflow: hidden;
        background: radial-gradient(1200px 800px at 50% 110%, #ffd6e0 0%, #fff0f4 45%, #fffafc 100%);
        color: #7a1f3d;
        font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "Source Han Serif SC", "SimSun", Georgia, serif;
        cursor: none;
      }
      canvas.hearts { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
      .center {
        position: fixed; inset: 0; display: grid; place-items: center; pointer-events: none; text-align: center;
      }
      .name {
        font-size: clamp(64px, 14vw, 180px); font-weight: 600; letter-spacing: 0.08em; line-height: 1;
        color: #c2185b;
        text-shadow: 0 0 40px rgba(255, 105, 150, 0.35), 0 2px 0 rgba(255,255,255,0.6);
        opacity: 0; transform: translateY(12px) scale(0.98);
        animation: rise 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards, beat 2.4s ease-in-out 2.2s infinite;
      }
      .name span { display: inline-block; opacity: 0; animation: glyph 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      .name span:nth-child(1) { animation-delay: 0.6s; }
      .name span:nth-child(2) { animation-delay: 1.0s; }
      .name span:nth-child(3) { animation-delay: 1.4s; }
      .sub {
        margin-top: 22px; font-size: clamp(15px, 2vw, 20px); letter-spacing: 0.3em; color: #a8386a;
        opacity: 0; animation: rise 1.4s ease 2.2s forwards;
      }
      .back {
        position: fixed; left: 18px; bottom: 16px; font: 13px/1 ui-monospace, monospace; color: #a8386a;
        text-decoration: none; opacity: 0.65; pointer-events: auto; cursor: pointer;
      }
      .back:hover { opacity: 1; }
      @keyframes rise { to { opacity: 1; transform: translateY(0) scale(1); } }
      @keyframes glyph { from { opacity: 0; transform: translateY(18px) rotate(-2deg); filter: blur(6px); } to { opacity: 1; transform: none; filter: blur(0); } }
      @keyframes beat { 0%, 100% { transform: scale(1); } 14% { transform: scale(1.035); } 28% { transform: scale(1); } 42% { transform: scale(1.025); } 70% { transform: scale(1); } }
      @media (prefers-reduced-motion: reduce) {
        .name, .name span, .sub { animation: none; opacity: 1; transform: none; }
        body.heart { cursor: auto; }
      }
    </style>
  </head>
  <body class="heart">
    <canvas class="hearts" aria-hidden="true"></canvas>
    <div class="center">
      <div>
        <div class="name" aria-label="卢梦轩"><span>卢</span><span>梦</span><span>轩</span></div>
        <div class="sub">你 是 我 最 喜 欢 的</div>
      </div>
    </div>
    <a class="back" href="/">← back</a>

    <script>
      // Gate: only reachable after answering the question in this session.
      if (sessionStorage.getItem("door") !== "open") {
        window.location.replace("/secret/");
      }

      const canvas = document.querySelector<HTMLCanvasElement>("canvas.hearts")!;
      const ctx = canvas.getContext("2d")!;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let w = 0, h = 0, dpr = 1;

      type Heart = { x: number; y: number; vx: number; vy: number; s: number; r: number; vr: number; a: number; life: number; hue: number; };
      const hearts: Heart[] = [];
      const pointer = { x: -1, y: -1, active: false };

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      window.addEventListener("resize", resize); resize();

      function spawn(x: number, y: number, n: number, burst = false) {
        for (let i = 0; i < n; i++) {
          const ang = Math.random() * Math.PI * 2;
          const sp = burst ? 1.5 + Math.random() * 3.5 : 0.2 + Math.random() * 0.6;
          hearts.push({
            x, y,
            vx: burst ? Math.cos(ang) * sp : (Math.random() - 0.5) * 0.6,
            vy: burst ? Math.sin(ang) * sp - 1 : -(0.6 + Math.random() * 1.2),
            s: burst ? 6 + Math.random() * 14 : 8 + Math.random() * 22,
            r: (Math.random() - 0.5) * 0.6, vr: (Math.random() - 0.5) * 0.02,
            a: 0.85, life: 1, hue: 330 + Math.random() * 30,
          });
        }
        if (hearts.length > 600) hearts.splice(0, hearts.length - 600);
      }

      function drawHeart(x: number, y: number, s: number, r: number, fill: string) {
        ctx.save(); ctx.translate(x, y); ctx.rotate(r); ctx.scale(s / 16, s / 16);
        ctx.beginPath();
        ctx.moveTo(0, 5);
        ctx.bezierCurveTo(0, 2, -3, -2, -7, -2);
        ctx.bezierCurveTo(-12, -2, -12, 5, -12, 5);
        ctx.bezierCurveTo(-12, 9, -8, 13, 0, 18);
        ctx.bezierCurveTo(8, 13, 12, 9, 12, 5);
        ctx.bezierCurveTo(12, 5, 12, -2, 7, -2);
        ctx.bezierCurveTo(3, -2, 0, 2, 0, 5);
        ctx.closePath();
        ctx.fillStyle = fill; ctx.fill();
        ctx.restore();
      }

      let last = performance.now();
      function frame(now: number) {
        const dt = Math.min(32, now - last) / 16.67; last = now;
        ctx.clearRect(0, 0, w, h);

        // ambient hearts rising from the bottom
        if (!reduced && Math.random() < 0.35 * dt) spawn(Math.random() * w, h + 20, 1);

        for (let i = hearts.length - 1; i >= 0; i--) {
          const p = hearts[i];
          p.x += p.vx * dt + Math.sin(now / 900 + p.s) * 0.25 * dt;
          p.y += p.vy * dt;
          p.vy *= 0.995; p.vx *= 0.985; p.r += p.vr * dt;
          p.life -= 0.0035 * dt;
          if (p.life <= 0 || p.y < -40) { hearts.splice(i, 1); continue; }
          const alpha = p.a * Math.min(1, p.life * 2.2);
          drawHeart(p.x, p.y, p.s, p.r, `hsla(${p.hue}, 85%, 62%, ${alpha})`);
        }

        // cursor: a small heart follows the pointer
        if (pointer.active && !reduced) drawHeart(pointer.x, pointer.y - 6, 14, 0, "rgba(194, 24, 91, 0.9)");
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);

      // interactions: move = trail, click/tap = burst
      let trail = 0;
      window.addEventListener("pointermove", (e) => {
        pointer.x = e.clientX; pointer.y = e.clientY; pointer.active = e.pointerType !== "touch";
        if (reduced) return;
        if (++trail % 3 === 0) spawn(e.clientX, e.clientY, 1);
      });
      window.addEventListener("pointerleave", () => { pointer.active = false; });
      window.addEventListener("pointerdown", (e) => { if (!reduced) spawn(e.clientX, e.clientY, 28, true); });

      // opening burst around the name
      setTimeout(() => { if (!reduced) spawn(w / 2, h / 2, 60, true); }, 1500);
    </script>
  </body>
</html>
