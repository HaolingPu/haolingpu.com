---
import Head from "@components/Head.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title="♡" description="For someone." noindex />
    <style>
      html, body { height: 100%; margin: 0; }
      body.heart {
        overflow: hidden; background: #06030d; color: #f4c6d6;
        font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", Georgia, serif;
        touch-action: none; user-select: none; -webkit-user-select: none;
      }
      canvas.stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
      .hud { position: fixed; inset: 0; pointer-events: none; }
      .hint {
        position: absolute; left: 0; right: 0; bottom: 22px; text-align: center;
        font: 12px/1.6 ui-monospace, Menlo, monospace; letter-spacing: 0.14em; color: rgba(244, 198, 214, 0.55);
      }
      .back {
        position: absolute; left: 18px; top: 16px; font: 13px/1 ui-monospace, monospace;
        color: rgba(244, 198, 214, 0.55); text-decoration: none; pointer-events: auto;
      }
      .back:hover { color: #fff; }
      .fallback {
        position: absolute; inset: 0; display: grid; place-items: center; text-align: center;
        transition: opacity 900ms ease;
      }
      .fallback .n { font-size: clamp(56px, 14vw, 150px); font-weight: 600; letter-spacing: 0.08em; color: #ff7aa8;
        text-shadow: 0 0 40px rgba(255, 90, 140, 0.55); }
      .fallback .s { margin-top: 18px; font: 12px/1.6 ui-monospace, monospace; letter-spacing: 0.2em; color: rgba(244,198,214,.55); }
      .fallback.hide { opacity: 0; pointer-events: none; }
    </style>
  </head>
  <body class="heart">
    <canvas class="stage" aria-label="卢梦轩" role="img"></canvas>
    <div class="hud">
      <a class="back" href="/">← back</a>
      <div class="fallback" data-fallback>
        <div>
          <div class="n">卢梦轩</div>
          <div class="s" data-fallback-msg>loading ♡</div>
        </div>
      </div>
      <div class="hint">tap · name ⇄ heart &nbsp;&nbsp; drag · rotate</div>
    </div>

    <script>
      /**
       * 3D particle heart on a plain 2D canvas (no WebGL required).
       * Particles are sampled from Taubin's heart surface, rotated and
       * perspective-projected by hand, and drawn as additive glow sprites.
       * Tap morphs the same particles into the name; drag rotates.
       */
      if (sessionStorage.getItem("door") !== "open") {
        window.location.replace("/secret/");
      }

      const NAME = "卢梦轩";
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const canvas = document.querySelector<HTMLCanvasElement>("canvas.stage")!;
      const ctx = canvas.getContext("2d", { alpha: false })!;
      let W = 0;
      let H = 0;
      let dpr = 1;
      const small = () => Math.min(window.innerWidth, window.innerHeight) < 640;
      const COUNT = small() ? 4500 : 7000;

      // ---------- heart sampling ----------
      function heartF(x: number, y: number, z: number) {
        const a = x * x + 2.25 * y * y + z * z - 1;
        return a * a * a - x * x * z * z * z - 0.1125 * y * y * z * z * z;
      }
      const hx = new Float32Array(COUNT);
      const hy = new Float32Array(COUNT);
      const hz = new Float32Array(COUNT);
      {
        let i = 0;
        while (i < COUNT) {
          const x = (Math.random() * 2 - 1) * 1.35;
          const d = (Math.random() * 2 - 1) * 0.95;
          const z = (Math.random() * 2 - 1) * 1.35;
          const f = heartF(x, d, z);
          if (Math.abs(f) < 0.02 || (f < 0 && Math.random() < 0.02)) {
            hx[i] = x;
            hy[i] = z - 0.12; // up
            hz[i] = d; // depth
            i++;
          }
        }
      }

      // ---------- name sampling ----------
      const tx = new Float32Array(COUNT);
      const ty = new Float32Array(COUNT);
      const tz = new Float32Array(COUNT);
      {
        const cw = 720;
        const ch = 300;
        const c = document.createElement("canvas");
        c.width = cw;
        c.height = ch;
        const g = c.getContext("2d")!;
        g.fillStyle = "#000";
        g.fillRect(0, 0, cw, ch);
        g.fillStyle = "#fff";
        g.textAlign = "center";
        g.textBaseline = "middle";
        g.font = `700 200px "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", serif`;
        g.fillText(NAME, cw / 2, ch / 2 + 8);
        const px = g.getImageData(0, 0, cw, ch).data;
        const pts: number[] = [];
        for (let y = 0; y < ch; y += 2) for (let x = 0; x < cw; x += 2) if (px[(y * cw + x) * 4] > 128) pts.push(x, y);
        const m = pts.length / 2;
        const s = 3.4 / cw;
        for (let i = 0; i < COUNT; i++) {
          const k = Math.floor(Math.random() * m);
          tx[i] = (pts[k * 2] - cw / 2) * s + (Math.random() - 0.5) * 0.012;
          ty[i] = -(pts[k * 2 + 1] - ch / 2) * s + (Math.random() - 0.5) * 0.012;
          tz[i] = (Math.random() - 0.5) * 0.1;
        }
      }

      const rnd = new Float32Array(COUNT);
      const dly = new Float32Array(COUNT);
      for (let i = 0; i < COUNT; i++) {
        rnd[i] = Math.random();
        dly[i] = Math.random();
      }

      // ---------- glow sprites (pre-rendered radial gradients) ----------
      function sprite(size: number, inner: string, outer: string) {
        const c = document.createElement("canvas");
        c.width = c.height = size;
        const g = c.getContext("2d")!;
        const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        grd.addColorStop(0, inner);
        grd.addColorStop(0.35, outer);
        grd.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = grd;
        g.fillRect(0, 0, size, size);
        return c;
      }
      const SPR = [
        sprite(32, "rgba(255,120,170,1)", "rgba(255,40,110,0.55)"), // rose
        sprite(32, "rgba(255,210,228,1)", "rgba(255,150,190,0.5)"), // pale
        sprite(32, "rgba(255,230,200,1)", "rgba(255,190,140,0.5)"), // gold (name)
      ];
      const kind = new Uint8Array(COUNT);
      for (let i = 0; i < COUNT; i++) {
        const r = Math.hypot(hx[i], hy[i]);
        kind[i] = Math.random() < 0.8 * Math.min(1, Math.max(0, (r - 0.2) / 1.1)) ? 1 : 0;
      }

      // ---------- stars (static layer) ----------
      let stars: HTMLCanvasElement | null = null;
      function makeStars() {
        stars = document.createElement("canvas");
        stars.width = Math.round(W * dpr);
        stars.height = Math.round(H * dpr);
        const g = stars.getContext("2d")!;
        g.scale(dpr, dpr);
        g.fillStyle = "#06030d";
        g.fillRect(0, 0, W, H);
        for (let i = 0; i < 260; i++) {
          const a = 0.15 + Math.random() * 0.5;
          g.fillStyle = `rgba(190,205,240,${a})`;
          const r = Math.random() < 0.1 ? 1.2 : 0.7;
          g.beginPath();
          g.arc(Math.random() * W, Math.random() * H, r, 0, Math.PI * 2);
          g.fill();
        }
      }

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        makeStars();
      }
      window.addEventListener("resize", resize);
      resize();

      // ---------- interaction ----------
      let mode = 0; // 0 heart, 1 name
      let mix = 0;
      let rotY = 0;
      let rotVel = 0;
      let tilt = 0;
      let tiltTarget = 0;
      let dragging = false;
      let moved = 0;
      let lastX = 0;
      let lastY = 0;

      canvas.addEventListener("pointerdown", (e) => {
        dragging = true;
        moved = 0;
        lastX = e.clientX;
        lastY = e.clientY;
        canvas.setPointerCapture(e.pointerId);
      });
      canvas.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        moved += Math.abs(dx) + Math.abs(dy);
        lastX = e.clientX;
        lastY = e.clientY;
        rotVel = dx * 0.005;
        rotY += rotVel;
        tiltTarget = Math.max(-0.6, Math.min(0.6, tiltTarget + dy * 0.003));
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        if (moved < 6) mode = 1 - mode;
      };
      canvas.addEventListener("pointerup", endDrag);
      canvas.addEventListener("pointercancel", endDrag);

      function beat(t: number) {
        const ph = (t * 1.1) % 1;
        const lub = Math.pow(Math.max(0, Math.sin(ph * Math.PI * 2)), 10);
        const dub = Math.pow(Math.max(0, Math.sin((ph - 0.22) * Math.PI * 2)), 10) * 0.55;
        return lub + dub;
      }

      // ---------- render loop ----------
      let running = true;
      let first = true;
      const t0 = performance.now();
      document.addEventListener("visibilitychange", () => {
        running = !document.hidden;
        if (running) requestAnimationFrame(frame);
      });

      function frame(now: number) {
        if (!running) return;
        const t = (now - t0) / 1000;
        mix += (mode - mix) * 0.045;
        const scale = reduced ? 1 : 1 + 0.07 * beat(t) * (1 - mix);

        if (!dragging) {
          if (mode === 0) {
            rotY += (reduced ? 0 : 0.0035) + rotVel;
            rotVel *= 0.94;
          } else {
            const target = Math.round(rotY / (Math.PI * 2)) * Math.PI * 2;
            rotY += (target - rotY) * 0.06;
            tiltTarget *= 0.9;
          }
        }
        tilt += (tiltTarget - tilt) * 0.08;

        const cy = Math.cos(rotY);
        const sy = Math.sin(rotY);
        const cx = Math.cos(tilt);
        const sx = Math.sin(tilt);
        const camZ = small() ? 4.2 : 3.4;
        const focal = Math.min(W, H) * (small() ? 1.05 : 0.95);
        const midX = W / 2;
        const midY = H / 2;

        ctx.globalCompositeOperation = "source-over";
        ctx.globalAlpha = 1;
        if (stars) ctx.drawImage(stars, 0, 0, W, H);
        ctx.globalCompositeOperation = "lighter";

        for (let i = 0; i < COUNT; i++) {
          const d = Math.min(1, Math.max(0, (mix - dly[i] * 0.35) / 0.65));
          const m = d * d * (3 - 2 * d); // smoothstep
          const drift = (1 - 0.6 * m) * 0.018;
          const r = rnd[i];
          let x = (hx[i] * scale) * (1 - m) + tx[i] * m + drift * Math.sin(t * 1.3 + r * 6.28);
          let y = (hy[i] * scale) * (1 - m) + ty[i] * m + drift * Math.cos(t * 1.1 + r * 3.1);
          let z = (hz[i] * scale) * (1 - m) + tz[i] * m + drift * Math.sin(t * 0.9 + r * 9.4);
          // rotate Y then X
          const x1 = x * cy + z * sy;
          const z1 = -x * sy + z * cy;
          const y1 = y * cx - z1 * sx;
          const z2 = y * sx + z1 * cx;
          const pz = camZ - z2 * 0.9;
          if (pz <= 0.2) continue;
          const p = focal / pz;
          const sxp = midX + x1 * 0.9 * p;
          const syp = midY - y1 * 0.9 * p;
          const tw = 0.75 + 0.25 * Math.sin(t * 2.6 + r * 40);
          const size = (5 + 9 * r) * tw * (p / focal) * (small() ? 3.4 : 3.0);
          ctx.globalAlpha = 0.6 * tw * (0.6 + 0.4 * Math.min(1, (camZ + 1.2 - pz)));
          const k = m > 0.5 ? (r < 0.35 ? 2 : kind[i]) : kind[i];
          ctx.drawImage(SPR[k], sxp - size / 2, syp - size / 2, size, size);
        }

        if (first) {
          first = false;
          document.querySelector("[data-fallback]")?.classList.add("hide");
        }
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    </script>
  </body>
</html>
