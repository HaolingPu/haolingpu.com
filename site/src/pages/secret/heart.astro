---
import Head from "@components/Head.astro";
// Everything personal (name, captions, photos) is decrypted client-side from /secret/vault.bin.
// This file, the repo, and the served HTML contain none of it.
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title="♡" description="♡" noindex />
    <style>
      html, body { margin: 0; }
      html { scroll-behavior: smooth; }
      body.heart {
        background: #06030d; color: #f4c6d6;
        font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", Georgia, serif;
        user-select: none; -webkit-user-select: none;
      }
      .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
      canvas.stage { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
      .hud { position: absolute; inset: 0; pointer-events: none; }
      .down {
        position: absolute; left: 0; right: 0; bottom: 56px; text-align: center; pointer-events: auto;
        font: 13px/1 ui-monospace, monospace; letter-spacing: 0.2em; color: rgba(244,198,214,.7); text-decoration: none;
        animation: bob 1.8s ease-in-out infinite;
      }
      @keyframes bob { 50% { transform: translateY(6px); } }

      /* ---------- gallery ---------- */
      .gallery {
        position: relative; padding: 96px 20px 120px; color: #7a1f3d;
        background: linear-gradient(180deg, #06030d 0, #2a0f1f 6%, #ffd6e4 14%, #fff0f5 40%, #fff7fa 100%);
      }
      .gallery::before {
        content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
        background-image: radial-gradient(rgba(255,120,170,.28) 1.4px, transparent 1.6px);
        background-size: 26px 26px;
      }
      .g-head { position: relative; text-align: center; margin: 60px auto 56px; max-width: 34rem; }
      .g-head h2 { margin: 0; font-size: clamp(30px, 6vw, 44px); font-weight: 600; letter-spacing: .08em; color: #d8286b; }
      .g-head p { margin: 12px 0 0; font-size: 15px; letter-spacing: .22em; color: #b04a75; }
      .stack { position: relative; display: flex; flex-direction: column; align-items: center; gap: 72px; }
      .card {
        position: relative; width: min(360px, 86vw); padding: 14px 14px 22px; background: #fff; border-radius: 14px;
        box-shadow: 0 24px 60px rgba(216, 40, 107, .16), 0 2px 0 #fff inset;
        transform: rotate(var(--tilt)) translateY(28px) scale(.96); opacity: 0;
        transition: transform 900ms cubic-bezier(.16,1,.3,1), opacity 700ms ease;
      }
      .card.in { transform: rotate(var(--tilt)) translateY(0) scale(1); opacity: 1; }
      .card:hover { transform: rotate(0deg) translateY(-4px) scale(1.02); }
      .card img { display: block; width: 100%; height: auto; border-radius: 8px; }
      .tape {
        position: absolute; top: -12px; width: 96px; height: 26px; border-radius: 3px;
        background: rgba(255, 150, 190, .55); backdrop-filter: blur(1px); transform: rotate(-6deg);
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
      }
      .tape.left { left: 22px; } .tape.right { right: 22px; transform: rotate(6deg); }
      .sticker {
        position: absolute; right: -14px; bottom: 54px; width: 44px; height: 44px; font-size: 26px; line-height: 44px; text-align: center;
        background: #ff6f9c; color: #fff; border-radius: 50%; box-shadow: 0 6px 14px rgba(255,111,156,.4); transform: rotate(12deg);
      }
      .cap { margin: 14px 4px 0; text-align: center; }
      .cap .n { font-size: 18px; color: #c2185b; letter-spacing: .04em; }
      .cap .s { margin-top: 6px; font-size: 13px; color: #b06a86; letter-spacing: .08em; }
      .sign { position: relative; text-align: center; margin-top: 88px; }
      .sign p { margin: 0; font-size: 17px; letter-spacing: .3em; color: #b04a75; }
      .sign .who { margin-top: 10px; font-size: 22px; color: #d8286b; letter-spacing: .2em; }
      .sign button {
        margin-top: 26px; font: inherit; font-size: 15px; letter-spacing: .2em; color: #fff; background: #ff5c93;
        border: 0; border-radius: 999px; padding: 12px 26px; cursor: pointer; box-shadow: 0 10px 24px rgba(255,92,147,.35);
        transition: transform 150ms ease;
      }
      .sign button:active { transform: scale(.96); }
      .burst { position: fixed; inset: 0; pointer-events: none; }
      @media (prefers-reduced-motion: reduce) { .card, .card.in { transition: none; opacity: 1; transform: rotate(var(--tilt)); } .down { animation: none; } }
      .hint {
        position: absolute; left: 0; right: 0; bottom: 22px; text-align: center;
        font: 12px/1.6 ui-monospace, Menlo, monospace; letter-spacing: 0.14em; color: rgba(244, 198, 214, 0.55);
      }
      .back {
        position: absolute; left: 18px; top: 16px; font: 13px/1 ui-monospace, monospace;
        color: rgba(244, 198, 214, 0.55); text-decoration: none; pointer-events: auto;
      }
      .back:hover { color: #fff; }
      .fallback {
        position: absolute; inset: 0; display: grid; place-items: center; text-align: center;
        transition: opacity 900ms ease;
      }
      .fallback .n { font-size: clamp(56px, 14vw, 150px); font-weight: 600; letter-spacing: 0.08em; color: #ff7aa8;
        text-shadow: 0 0 40px rgba(255, 90, 140, 0.55); }
      .fallback .s { margin-top: 18px; font: 12px/1.6 ui-monospace, monospace; letter-spacing: 0.2em; color: rgba(244,198,214,.55); }
      .fallback.hide { opacity: 0; pointer-events: none; }
    </style>
  </head>
  <body class="heart">
    <section class="hero">
    <canvas class="stage" aria-label="heart" role="img"></canvas>
    <div class="hud">
      <a class="back" href="/">← back</a>
      <a class="down" href="#photos" aria-label="往下看">往下看 ↓</a>
      <div class="fallback" data-fallback>
        <div>
          <div class="n" data-name>♡</div>
          <div class="s" data-fallback-msg>loading ♡</div>
        </div>
      </div>
      <div class="hint">tap · name ⇄ heart &nbsp;&nbsp; drag · rotate</div>
    </div>
    </section>

    <section class="gallery" id="photos">
      <div class="g-head">
        <h2 data-heading></h2>
        <p data-heading-sub></p>
      </div>
      <div class="stack" data-stack></div>
      <div class="sign">
        <p data-sign></p>
        <div class="who" data-who></div>
        <button type="button" data-burst-btn></button>
      </div>
    </section>
    <canvas class="burst" data-burst aria-hidden="true"></canvas>

    <script>
      /**
       * 3D particle heart on a plain 2D canvas (no WebGL required).
       * Particles are sampled from Taubin's heart surface, rotated and
       * perspective-projected by hand, and drawn as additive glow sprites.
       * Tap morphs the same particles into the name; drag rotates.
       */
      import { open } from "@lib/vault";
      const vaultKey = sessionStorage.getItem("vault");
      if (!vaultKey) window.location.replace("/secret/");
      const payload = vaultKey ? await open(vaultKey) : null;
      if (!payload) {
        sessionStorage.removeItem("vault");
        window.location.replace("/secret/");
        throw new Error("locked");
      }
      const NAME = payload.name;
      const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
      $("[data-name]")!.textContent = payload.name;
      $("[data-fallback-msg]")!.textContent = payload.sub;
      $("[data-heading]")!.textContent = payload.heading;
      $("[data-heading-sub]")!.textContent = payload.headingSub;
      $("[data-sign]")!.textContent = payload.sign;
      $("[data-who]")!.textContent = payload.who;
      $("[data-burst-btn]")!.textContent = payload.button;
      // gallery cards from decrypted photos (blob URLs never touch the network)
      const stack = $("[data-stack]")!;
      payload.photos.forEach((p, i) => {
        const bytes = Uint8Array.from(atob(p.webp), (c) => c.charCodeAt(0));
        const url = URL.createObjectURL(new Blob([bytes], { type: "image/webp" }));
        const fig = document.createElement("figure");
        fig.className = "card";
        fig.style.setProperty("--tilt", `${p.tilt}deg`);
        fig.dataset.card = "";
        fig.innerHTML = `<span class="tape ${p.tape}" aria-hidden="true"></span><img alt="${i + 1}" decoding="async"><span class="sticker" aria-hidden="true">♥</span><figcaption class="cap"><div class="n"></div><div class="s"></div></figcaption>`;
        (fig.querySelector("img") as HTMLImageElement).src = url;
        (fig.querySelector(".cap .n") as HTMLElement).textContent = p.note;
        (fig.querySelector(".cap .s") as HTMLElement).textContent = p.sub;
        stack.appendChild(fig);
      });
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const canvas = document.querySelector<HTMLCanvasElement>("canvas.stage")!;
      const ctx = canvas.getContext("2d", { alpha: false })!;
      let W = 0;
      let H = 0;
      let dpr = 1;
      const small = () => Math.min(window.innerWidth, window.innerHeight) < 640;
      const COUNT = small() ? 4500 : 7000;

      // ---------- heart sampling ----------
      function heartF(x: number, y: number, z: number) {
        const a = x * x + 2.25 * y * y + z * z - 1;
        return a * a * a - x * x * z * z * z - 0.1125 * y * y * z * z * z;
      }
      const hx = new Float32Array(COUNT);
      const hy = new Float32Array(COUNT);
      const hz = new Float32Array(COUNT);
      {
        let i = 0;
        while (i < COUNT) {
          const x = (Math.random() * 2 - 1) * 1.35;
          const d = (Math.random() * 2 - 1) * 0.95;
          const z = (Math.random() * 2 - 1) * 1.35;
          const f = heartF(x, d, z);
          if (Math.abs(f) < 0.02 || (f < 0 && Math.random() < 0.02)) {
            hx[i] = x;
            hy[i] = z - 0.12; // up
            hz[i] = d; // depth
            i++;
          }
        }
      }

      // ---------- name sampling ----------
      const tx = new Float32Array(COUNT);
      const ty = new Float32Array(COUNT);
      const tz = new Float32Array(COUNT);
      {
        const cw = 720;
        const ch = 300;
        const c = document.createElement("canvas");
        c.width = cw;
        c.height = ch;
        const g = c.getContext("2d")!;
        g.fillStyle = "#000";
        g.fillRect(0, 0, cw, ch);
        g.fillStyle = "#fff";
        g.textAlign = "center";
        g.textBaseline = "middle";
        g.font = `700 200px "Songti SC", "STSong", "Noto Serif CJK SC", "Noto Serif SC", "SimSun", serif`;
        g.fillText(NAME, cw / 2, ch / 2 + 8);
        const px = g.getImageData(0, 0, cw, ch).data;
        const pts: number[] = [];
        for (let y = 0; y < ch; y += 2) for (let x = 0; x < cw; x += 2) if (px[(y * cw + x) * 4] > 128) pts.push(x, y);
        const m = pts.length / 2;
        const s = 3.4 / cw;
        for (let i = 0; i < COUNT; i++) {
          const k = Math.floor(Math.random() * m);
          tx[i] = (pts[k * 2] - cw / 2) * s + (Math.random() - 0.5) * 0.012;
          ty[i] = -(pts[k * 2 + 1] - ch / 2) * s + (Math.random() - 0.5) * 0.012;
          tz[i] = (Math.random() - 0.5) * 0.1;
        }
      }

      const rnd = new Float32Array(COUNT);
      const dly = new Float32Array(COUNT);
      for (let i = 0; i < COUNT; i++) {
        rnd[i] = Math.random();
        dly[i] = Math.random();
      }

      // ---------- glow sprites (pre-rendered radial gradients) ----------
      function sprite(size: number, inner: string, outer: string) {
        const c = document.createElement("canvas");
        c.width = c.height = size;
        const g = c.getContext("2d")!;
        const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        grd.addColorStop(0, inner);
        grd.addColorStop(0.35, outer);
        grd.addColorStop(1, "rgba(0,0,0,0)");
        g.fillStyle = grd;
        g.fillRect(0, 0, size, size);
        return c;
      }
      const SPR = [
        sprite(32, "rgba(255,120,170,1)", "rgba(255,40,110,0.55)"), // rose
        sprite(32, "rgba(255,210,228,1)", "rgba(255,150,190,0.5)"), // pale
        sprite(32, "rgba(255,230,200,1)", "rgba(255,190,140,0.5)"), // gold (name)
      ];
      const kind = new Uint8Array(COUNT);
      for (let i = 0; i < COUNT; i++) {
        const r = Math.hypot(hx[i], hy[i]);
        kind[i] = Math.random() < 0.8 * Math.min(1, Math.max(0, (r - 0.2) / 1.1)) ? 1 : 0;
      }

      // ---------- stars (static layer) ----------
      let stars: HTMLCanvasElement | null = null;
      function makeStars() {
        stars = document.createElement("canvas");
        stars.width = Math.round(W * dpr);
        stars.height = Math.round(H * dpr);
        const g = stars.getContext("2d")!;
        g.scale(dpr, dpr);
        g.fillStyle = "#06030d";
        g.fillRect(0, 0, W, H);
        for (let i = 0; i < 260; i++) {
          const a = 0.15 + Math.random() * 0.5;
          g.fillStyle = `rgba(190,205,240,${a})`;
          const r = Math.random() < 0.1 ? 1.2 : 0.7;
          g.beginPath();
          g.arc(Math.random() * W, Math.random() * H, r, 0, Math.PI * 2);
          g.fill();
        }
      }

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        const r = canvas.getBoundingClientRect();
        W = r.width;
        H = r.height;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        makeStars();
      }
      window.addEventListener("resize", resize);
      resize();

      // ---------- interaction ----------
      let mode = 0; // 0 heart, 1 name
      let mix = 0;
      let rotY = 0;
      let rotVel = 0;
      let tilt = 0;
      let tiltTarget = 0;
      let dragging = false;
      let moved = 0;
      let lastX = 0;
      let lastY = 0;

      canvas.addEventListener("pointerdown", (e) => {
        dragging = true;
        moved = 0;
        lastX = e.clientX;
        lastY = e.clientY;
        canvas.setPointerCapture(e.pointerId);
      });
      canvas.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        moved += Math.abs(dx) + Math.abs(dy);
        lastX = e.clientX;
        lastY = e.clientY;
        rotVel = dx * 0.005;
        rotY += rotVel;
        tiltTarget = Math.max(-0.6, Math.min(0.6, tiltTarget + dy * 0.003));
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        if (moved < 6) mode = 1 - mode;
      };
      canvas.addEventListener("pointerup", endDrag);
      canvas.addEventListener("pointercancel", endDrag);

      function beat(t: number) {
        const ph = (t * 1.1) % 1;
        const lub = Math.pow(Math.max(0, Math.sin(ph * Math.PI * 2)), 10);
        const dub = Math.pow(Math.max(0, Math.sin((ph - 0.22) * Math.PI * 2)), 10) * 0.55;
        return lub + dub;
      }

      // ---------- render loop ----------
      let running = true;
      let first = true;
      const t0 = performance.now();
      // pause the heart while it is scrolled out of view
      new IntersectionObserver(([e]) => {
        const on = e.isIntersecting && !document.hidden;
        if (on && !running) { running = true; requestAnimationFrame(frame); } else if (!on) running = false;
      }).observe(canvas);

      // ---------- gallery: reveal cards one after another ----------
      const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];
      let queue = 0;
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          const delay = Math.min(queue * 260, 800);
          queue++;
          setTimeout(() => { el.classList.add("in"); queue = Math.max(0, queue - 1); }, delay);
        }
      }, { threshold: 0.25 });
      cards.forEach((c) => io.observe(c));

      // ---------- burst hearts (2D) ----------
      const bc = document.querySelector<HTMLCanvasElement>("canvas[data-burst]")!;
      const bctx = bc.getContext("2d")!;
      type P = { x: number; y: number; vx: number; vy: number; s: number; r: number; vr: number; life: number; hue: number };
      let parts: P[] = [];
      let bRaf = 0;
      function bResize() { bc.width = window.innerWidth * dpr; bc.height = window.innerHeight * dpr; bctx.setTransform(dpr, 0, 0, dpr, 0, 0); }
      window.addEventListener("resize", bResize);
      function heartPath(g: CanvasRenderingContext2D, x: number, y: number, s: number, r: number) {
        g.save(); g.translate(x, y); g.rotate(r); g.scale(s / 16, s / 16);
        g.beginPath(); g.moveTo(0, 5); g.bezierCurveTo(0, 2, -3, -2, -7, -2); g.bezierCurveTo(-12, -2, -12, 5, -12, 5);
        g.bezierCurveTo(-12, 9, -8, 13, 0, 18); g.bezierCurveTo(8, 13, 12, 9, 12, 5); g.bezierCurveTo(12, 5, 12, -2, 7, -2);
        g.bezierCurveTo(3, -2, 0, 2, 0, 5); g.closePath(); g.restore();
      }
      function bFrame() {
        bctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        for (let i = parts.length - 1; i >= 0; i--) {
          const p = parts[i];
          p.x += p.vx; p.y += p.vy; p.vy += 0.06; p.vx *= 0.99; p.r += p.vr; p.life -= 0.012;
          if (p.life <= 0) { parts.splice(i, 1); continue; }
          bctx.globalAlpha = Math.min(1, p.life * 2);
          bctx.fillStyle = `hsl(${p.hue}, 90%, 62%)`;
          heartPath(bctx, p.x, p.y, p.s, p.r); bctx.fill();
        }
        bctx.globalAlpha = 1;
        if (parts.length) bRaf = requestAnimationFrame(bFrame); else bRaf = 0;
      }
      function burst(x: number, y: number) {
        if (!bc.width) bResize();
        for (let i = 0; i < 70; i++) {
          const a = Math.random() * Math.PI * 2, sp = 3 + Math.random() * 7;
          parts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 3, s: 10 + Math.random() * 18, r: Math.random() * 6, vr: (Math.random() - 0.5) * 0.2, life: 1, hue: 325 + Math.random() * 30 });
        }
        if (!bRaf) bRaf = requestAnimationFrame(bFrame);
      }
      document.querySelector("[data-burst-btn]")?.addEventListener("click", (e) => {
        const r = (e.currentTarget as HTMLElement).getBoundingClientRect();
        burst(r.left + r.width / 2, r.top + r.height / 2);
      });
      let prev = t0;
      document.addEventListener("visibilitychange", () => {
        running = !document.hidden;
        if (running) requestAnimationFrame(frame);
      });

      function frame(now: number) {
        if (!running) return;
        const t = (now - t0) / 1000;
        const dt = Math.min(2, (now - prev) / 16.67); // frames at 60 Hz, so speed is the same on 120 Hz screens
        prev = now;
        mix += (mode - mix) * 0.045 * dt;
        const scale = reduced ? 1 : 1 + 0.07 * beat(t) * (1 - mix);

        if (!dragging) {
          if (mode === 0) {
            rotY += ((reduced ? 0 : 0.0035) + rotVel) * dt;
            rotVel *= Math.pow(0.94, dt);
          } else {
            const target = Math.round(rotY / (Math.PI * 2)) * Math.PI * 2;
            rotY += (target - rotY) * 0.06 * dt;
            tiltTarget *= Math.pow(0.9, dt);
          }
        }
        tilt += (tiltTarget - tilt) * 0.08 * dt;

        const cy = Math.cos(rotY);
        const sy = Math.sin(rotY);
        const cx = Math.cos(tilt);
        const sx = Math.sin(tilt);
        const camZ = small() ? 4.2 : 3.4;
        const focal = Math.min(W, H) * (small() ? 1.05 : 0.95);
        const midX = W / 2;
        const midY = H / 2;

        ctx.globalCompositeOperation = "source-over";
        ctx.globalAlpha = 1;
        if (stars) ctx.drawImage(stars, 0, 0, W, H);
        ctx.globalCompositeOperation = "lighter";

        for (let i = 0; i < COUNT; i++) {
          const d = Math.min(1, Math.max(0, (mix - dly[i] * 0.35) / 0.65));
          const m = d * d * (3 - 2 * d); // smoothstep
          const drift = (1 - 0.6 * m) * 0.018;
          const r = rnd[i];
          let x = (hx[i] * scale) * (1 - m) + tx[i] * m + drift * Math.sin(t * 1.3 + r * 6.28);
          let y = (hy[i] * scale) * (1 - m) + ty[i] * m + drift * Math.cos(t * 1.1 + r * 3.1);
          let z = (hz[i] * scale) * (1 - m) + tz[i] * m + drift * Math.sin(t * 0.9 + r * 9.4);
          // rotate Y then X
          const x1 = x * cy + z * sy;
          const z1 = -x * sy + z * cy;
          const y1 = y * cx - z1 * sx;
          const z2 = y * sx + z1 * cx;
          const pz = camZ - z2 * 0.9;
          if (pz <= 0.2) continue;
          const p = focal / pz;
          const sxp = midX + x1 * 0.9 * p;
          const syp = midY - y1 * 0.9 * p;
          const tw = 0.75 + 0.25 * Math.sin(t * 2.6 + r * 40);
          const size = (5 + 9 * r) * tw * (p / focal) * (small() ? 3.4 : 3.0);
          ctx.globalAlpha = 0.6 * tw * (0.6 + 0.4 * Math.min(1, (camZ + 1.2 - pz)));
          const k = m > 0.5 ? (r < 0.35 ? 2 : kind[i]) : kind[i];
          ctx.drawImage(SPR[k], sxp - size / 2, syp - size / 2, size, size);
        }

        if (first) {
          first = false;
          document.querySelector("[data-fallback]")?.classList.add("hide");
        }
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    </script>
  </body>
</html>
