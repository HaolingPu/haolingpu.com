---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProseLayout from "@layouts/ProseLayout.astro";
import { readingTime } from "@lib/utils";

export async function getStaticPaths() {
  const posts = (await getCollection("writing"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

type Props = {
  post: CollectionEntry<"writing">;
  prev?: CollectionEntry<"writing">;
  next?: CollectionEntry<"writing">;
};

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const neighbor = (p?: CollectionEntry<"writing">) =>
  p ? { href: `/writing/${p.id}`, title: p.data.title } : undefined;
---

<ProseLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  readingTime={readingTime(post.body ?? "")}
  headings={headings}
  backHref="/writing"
  backLabel="Back to writing"
  prev={neighbor(prev)}
  next={neighbor(next)}
>
  <Content />
</ProseLayout>
