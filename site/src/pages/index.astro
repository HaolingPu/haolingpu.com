---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import headshot from "@assets/photos/headshot.jpg";
import campus from "@assets/photos/michigan-union.jpg";
import AttentionField from "@components/AttentionField.astro";
import Behaviors from "@components/Behaviors.astro";
import EducationRow from "@components/EducationRow.astro";
import HobbyIcon from "@components/HobbyIcon.astro";
import Logo from "@components/Logo.astro";
import ProjectRow from "@components/ProjectRow.astro";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import WorkRow from "@components/WorkRow.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { EDUCATION, HOBBIES, HOME, SITE, SOCIALS } from "@site.config";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection("writing"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const github = SOCIALS.find((s) => s.NAME === "github")?.HREF ?? "#";
const linkedin = SOCIALS.find((s) => s.NAME === "linkedin")?.HREF ?? "#";
---

<BaseLayout title="Home" description={HOME.DESCRIPTION}>
  <Container>
    <!-- Intro -->
    <section class="animate">
      <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between sm:gap-12">
        <div class="max-w-[40rem] flex-1">
          <h1 class="text-[28px] font-semibold tracking-tight sm:text-[32px]">{SITE.NAME}</h1>
          <p class="mt-1 text-[15px] text-fg-subtle">
            ML systems engineer · MS in AI &amp; Innovation, Carnegie Mellon '27 · Pittsburgh
          </p>
          <ul class="mt-4 flex flex-wrap items-center gap-2" aria-label="Links">
            <li><a href={github} target="_blank" rel="noopener noreferrer" class="chip"><svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>GitHub</a></li>
            <li><a href={linkedin} target="_blank" rel="noopener noreferrer" class="chip"><svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1zM7.1 20.4H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>LinkedIn</a></li>
            <li><a href="/Haoling_Pu_Resume.pdf" target="_blank" rel="noopener noreferrer" class="chip chip-accent"><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[1.8]" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>Résumé</a></li>
            <li><button type="button" data-copy={SITE.EMAIL} class="chip" aria-label={`Copy email ${SITE.EMAIL}`}><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[1.8]" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span class="when-idle">Email</span><span class="when-copied">Copied ✓</span></button></li>
          </ul>

                    <div class="prose mt-6 text-[16.5px] leading-[1.7]">
            <p>
              I'm a master's student at <a href="https://www.cs.cmu.edu">Carnegie Mellon's School of Computer Science</a> and an ML systems engineer. I like the layer where the model meets the hardware and the product: kernels, serving, and the agents that sit on top.
            </p>
            <p>
              This summer at <a href="https://about.google">Google</a> I taught an agent to keep a team's knowledge base alive. At CMU's <a href="https://www.lti.cs.cmu.edu">Language Technologies Institute</a> I work on speech translation that starts before the sentence ends. Before that, computer science at the <a href="https://umich.edu">University of Michigan</a>.
            </p>
            <p>
              Things I've built: a <a href="/projects/sparse-attention-blackwell">sparse attention kernel</a> that made NVIDIA's competition workloads fly, a <a href="/projects/llm-wiki">wiki that writes itself</a>, and a <a href="/projects/hybrid-rag">retrieval system with two brains</a>. The full story is in the résumé; the interesting parts are below.
            </p>
            <p>
              I'm looking for 2027 new-grad ML and software engineering roles. Email is the best way to reach me.
            </p>
          </div>
        </div>

        <!-- Photo. The attention field stays as a hover overlay (ROADMAP G9). -->
        <div class="group relative size-48 shrink-0 overflow-hidden rounded-xl border border-border bg-surface sm:size-60 md:size-[17rem]">
          <Image src={headshot} alt="Haoling Pu at his Michigan graduation" width={544} height={544} class="size-full object-cover" loading="eager" />
          <div class="absolute inset-0 bg-bg/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true">
            <AttentionField spacing={16} sigma={46} topK={5} />
          </div>
        </div>
      </div>
    </section>

    <Section eyebrow="work" class="animate">
      <a slot="action" href="/work" class="link-quiet">all roles</a>
      <ul class="rule-list">{work.slice(0, 3).map((entry) => <WorkRow entry={entry} compact />)}</ul>
    </Section>

    <Section eyebrow="education" class="animate">
      <ul class="rule-list">{EDUCATION.map((edu) => <EducationRow edu={edu} compact />)}</ul>
      <figure class="mt-5">
        <Image src={campus} alt="Sitting on the Michigan Union sign in cap and gown, Ann Arbor, May 2025" widths={[640, 960, 1408]} sizes="(min-width: 768px) 704px, 100vw" class="w-full rounded-lg border border-border" />
        <figcaption class="mt-2 font-mono text-[12px] text-fg-subtle">Michigan Union, Ann Arbor · May 2025</figcaption>
      </figure>
    </Section>

    <Section eyebrow="projects" class="animate">
      <a slot="action" href="/projects" class="link-quiet">all projects</a>
      <ul class="rule-list">{projects.map((p) => <ProjectRow project={p} />)}</ul>
    </Section>

    <Section eyebrow="research" class="animate">
      <a slot="action" href="/research" class="link-quiet">more</a>
      <ul class="rule-list">
        {
          research.map((r) => (
            <li class="py-3">
              <div class="flex flex-wrap items-baseline gap-x-2">
                {r.data.logo && <Logo name={r.data.logo} class="mr-0.5" />}
                <a href="/research" class="link font-medium">{r.data.title}</a>
                <span class="text-sm text-fg-subtle">· {r.data.venue} · {r.data.status}</span>
              </div>
              <p class="mt-0.5 text-[15px] leading-relaxed text-fg-muted">{r.data.summary}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    {
      writing.length > 0 && (
        <Section eyebrow="writing" class="animate">
          <a slot="action" href="/writing" class="link-quiet">all writing</a>
          <ul class="rule-list">
            {writing.map((post) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <a href={`/writing/${post.id}`} class="link">{post.data.title}</a>
                <span class="font-mono text-[12.5px] text-fg-subtle">{post.data.date.toISOString().slice(0, 10)}</span>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section eyebrow="off the clock" class="animate">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-fg-muted">
        {
          HOBBIES.map((h) => (
            <li class="flex items-center gap-1.5">
              <HobbyIcon name={h.ICON} class="size-4 text-fg-subtle" />
              {h.LABEL}
            </li>
          ))
        }
      </ul>
    </Section>
  </Container>
  <Behaviors />
</BaseLayout>
