---
import { getCollection } from "astro:content";
import AttentionField from "@components/AttentionField.astro";
import Behaviors from "@components/Behaviors.astro";
import EducationRow from "@components/EducationRow.astro";
import HobbyIcon from "@components/HobbyIcon.astro";
import ProjectRow from "@components/ProjectRow.astro";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import WorkRow from "@components/WorkRow.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { EDUCATION, HOBBIES, HOME, SITE, SOCIALS } from "@site.config";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection("writing"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const github = SOCIALS.find((s) => s.NAME === "github")?.HREF ?? "#";
const linkedin = SOCIALS.find((s) => s.NAME === "linkedin")?.HREF ?? "#";
---

<BaseLayout title="Home" description={HOME.DESCRIPTION}>
  <Container>
    <!-- Intro -->
    <section class="animate">
      <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-[38rem]">
          <h1 class="text-[28px] font-semibold tracking-tight sm:text-[32px]">{SITE.NAME}</h1>
          <p class="mt-1 text-[15px] text-fg-subtle">
            ML systems engineer · MS in AI &amp; Innovation, Carnegie Mellon '27 · Pittsburgh
          </p>

          <div class="prose mt-6 text-[16.5px] leading-[1.7]">
            <p>
              I'm a master's student at <a href="https://www.cs.cmu.edu">Carnegie Mellon's School of Computer Science</a> and an ML systems engineer. I like the part of machine learning where the model meets the hardware and the product: kernels, serving, and the agents that sit on top.
            </p>
            <p>
              This summer I was a software engineering intern at <a href="https://about.google">Google</a>, where I built an agentic system that generates and continuously maintains an engineering team's knowledge base. At CMU I do research in the <a href="https://www.lti.cs.cmu.edu">Language Technologies Institute</a> on simultaneous speech translation: how a model can commit to a translation before the speaker finishes. Before CMU I studied Computer Science and Data Science at the <a href="https://umich.edu">University of Michigan</a>.
            </p>
            <p>
              Things I've built: a <a href="/projects/sparse-attention-blackwell">Blackwell-optimized sparse attention kernel</a> that ran 22–35× faster than the PyTorch reference in the NVIDIA MLSys 2026 competition, a <a href="/projects/llm-wiki">self-maintaining LLM wiki</a>, and a <a href="/projects/hybrid-rag">hybrid retrieval system</a>. I've also interned at <a href="https://www.weride.ai">WeRide</a>, cutting cold-start latency on a Kubernetes platform by 88%.
            </p>
            <p>
              I'm looking for 2027 new-grad ML and software engineering roles. Email is the best way to reach me: <button type="button" data-copy={SITE.EMAIL} class="link inline-flex cursor-pointer items-baseline gap-1 border-0 bg-transparent p-0 font-[inherit] text-[inherit]" aria-label={`Copy email ${SITE.EMAIL}`}><span class="when-idle">{SITE.EMAIL}</span><span class="when-copied">copied ✓</span></button>. Also on <a href={github}>GitHub</a> and <a href={linkedin}>LinkedIn</a>. Here's my <a href="/Haoling_Pu_Resume.pdf">résumé</a>.
            </p>
          </div>
        </div>

        <!-- Photo slot. The attention field lives here until a headshot exists (ROADMAP Q6 / G10). -->
        <div class="relative size-40 shrink-0 overflow-hidden rounded-lg border border-border bg-surface sm:size-44" title="Photo coming. Meanwhile: attention.">
          <AttentionField spacing={16} sigma={46} topK={5} />
        </div>
      </div>
    </section>

    <Section eyebrow="work" class="animate">
      <a slot="action" href="/work" class="link-quiet">all roles</a>
      <ul class="rule-list">{work.slice(0, 3).map((entry) => <WorkRow entry={entry} compact />)}</ul>
    </Section>

    <Section eyebrow="education" class="animate">
      <ul class="rule-list">{EDUCATION.map((edu) => <EducationRow edu={edu} compact />)}</ul>
    </Section>

    <Section eyebrow="projects" class="animate">
      <a slot="action" href="/projects" class="link-quiet">all projects</a>
      <ul class="rule-list">{projects.map((p) => <ProjectRow project={p} />)}</ul>
    </Section>

    <Section eyebrow="research" class="animate">
      <a slot="action" href="/research" class="link-quiet">more</a>
      <ul class="rule-list">
        {
          research.map((r) => (
            <li class="py-3">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <a href="/research" class="link font-medium">{r.data.title}</a>
                <span class="text-sm text-fg-subtle">· {r.data.venue} · {r.data.status}</span>
              </div>
              <p class="mt-0.5 text-[15px] leading-relaxed text-fg-muted">{r.data.summary}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    {
      writing.length > 0 && (
        <Section eyebrow="writing" class="animate">
          <a slot="action" href="/writing" class="link-quiet">all writing</a>
          <ul class="rule-list">
            {writing.map((post) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <a href={`/writing/${post.id}`} class="link">{post.data.title}</a>
                <span class="font-mono text-[12.5px] text-fg-subtle">{post.data.date.toISOString().slice(0, 10)}</span>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section eyebrow="off the clock" class="animate">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-fg-muted">
        {
          HOBBIES.map((h) => (
            <li class="flex items-center gap-1.5">
              <HobbyIcon name={h.ICON} class="size-4 text-fg-subtle" />
              {h.LABEL}
            </li>
          ))
        }
      </ul>
    </Section>
  </Container>
  <Behaviors />
</BaseLayout>
