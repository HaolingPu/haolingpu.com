---
import { getCollection } from "astro:content";
import Container from "@components/ui/Container.astro";
import WorkRow from "@components/WorkRow.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { WORK } from "@site.config";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
---

<BaseLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <h1 class="animate text-[28px] font-semibold tracking-tight">Work</h1>
    <p class="animate mt-2 text-fg-muted">{WORK.DESCRIPTION}</p>
    <ul class="rule-list animate mt-8">{work.map((entry) => <WorkRow entry={entry} />)}</ul>
  </Container>
</BaseLayout>
