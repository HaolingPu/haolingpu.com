---
import { getCollection } from "astro:content";
import Container from "@components/ui/Container.astro";
import WorkRow from "@components/WorkRow.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { WORK } from "@site.config";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
---

<BaseLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container size="wide">
    <div class="animate font-mono text-xs uppercase tracking-[0.12em] text-fg-subtle">work</div>
    <h1 class="animate mt-2 text-display">Where I've built</h1>
    <p class="animate mt-3 max-w-[60ch]">{WORK.DESCRIPTION}</p>
    <div class="animate mt-12 space-y-10 border-t border-border pt-10">
      {work.map((entry) => <WorkRow entry={entry} />)}
    </div>
  </Container>
</BaseLayout>
