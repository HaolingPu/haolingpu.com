---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import headshot from "@assets/photos/headshot.jpg";
import campus from "@assets/photos/michigan-union.jpg";
import AttentionField from "@components/AttentionField.astro";
import Behaviors from "@components/Behaviors.astro";
import EducationRow from "@components/EducationRow.astro";
import HobbyIcon from "@components/HobbyIcon.astro";
import Logo from "@components/Logo.astro";
import ProjectRow from "@components/ProjectRow.astro";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import WorkRow from "@components/WorkRow.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { EDUCATION, HOBBIES, SITE, SOCIALS, UI } from "@site.config";

const ui = UI.zh;
const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order);
const github = SOCIALS.find((s) => s.NAME === "github")?.HREF ?? "#";
const linkedin = SOCIALS.find((s) => s.NAME === "linkedin")?.HREF ?? "#";
---

<BaseLayout
  lang="zh"
  title="Home"
  description="蒲浩领 Haoling Pu — 机器学习系统工程师，卡内基梅隆大学 AI 硕士，Google 实习，CUDA 算子、LLM 智能体、同声传译研究。"
>
  <Container>
    <section class="animate">
      <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between sm:gap-12">
        <div class="max-w-[40rem] flex-1">
          <h1 class="text-[28px] font-semibold tracking-tight sm:text-[32px]">蒲浩领 <span class="ml-1 text-[18px] font-normal text-fg-subtle sm:text-[20px]">Haoling Pu</span></h1>
          <p class="mt-1 text-[15px] text-fg-subtle">机器学习系统工程师 · 卡内基梅隆大学 人工智能与创新 硕士，2027 届 · 匹兹堡</p>

          <div class="prose mt-6 text-[16.5px] leading-[1.85]">
            <p>
              我是<a href="https://www.cs.cmu.edu">卡内基梅隆大学计算机学院</a>的硕士生，做机器学习系统。我最感兴趣的是模型与硬件、产品交汇的那一层：算子、推理服务，以及跑在它们之上的智能体。
            </p>
            <p>
              今年夏天我在 <a href="https://about.google">Google</a> 做软件工程实习，搭建了一个能自动生成并持续维护工程团队知识库的智能体系统。在 CMU，我在<a href="https://www.lti.cs.cmu.edu">语言技术研究所</a>做同声传译方向的研究：模型如何在说话人说完之前，就决定该翻译什么。此前我在<a href="https://umich.edu">密歇根大学</a>读计算机科学与数据科学本科。
            </p>
            <p>
              做过的东西：在 NVIDIA MLSys 2026 竞赛中写了一个<a href="/zh/projects/sparse-attention-blackwell">面向 Blackwell 的稀疏注意力 CUDA 算子</a>，比 PyTorch 参考实现快 22–35 倍；一个<a href="/zh/projects/llm-wiki">能自我维护的 LLM 维基</a>；一个<a href="/zh/projects/hybrid-rag">混合检索系统</a>。也在<a href="https://www.weride.ai">文远知行 WeRide</a> 实习过，把 Kubernetes 平台上的冷启动延迟降低了 88%。
            </p>
            <p>
              我正在寻找 2027 届的机器学习 / 软件工程全职岗位。最方便的联系方式是邮件：<button type="button" data-copy={SITE.EMAIL} class="link inline-flex cursor-pointer items-baseline gap-1 border-0 bg-transparent p-0 font-[inherit] text-[inherit]" aria-label={`复制邮箱 ${SITE.EMAIL}`}><span class="when-idle">{SITE.EMAIL}</span><span class="when-copied">已复制 ✓</span></button>。也可以在 <a href={github}>GitHub</a> 和 <a href={linkedin}>LinkedIn</a> 找到我。这是我的<a href="/Haoling_Pu_Resume.pdf">简历</a>。
            </p>
          </div>
        </div>
        <!-- Photo. The attention field stays as a hover overlay (ROADMAP G9). -->
        <div class="group relative size-48 shrink-0 overflow-hidden rounded-xl border border-border bg-surface sm:size-60 md:size-[17rem]">
          <Image src={headshot} alt="蒲浩领，密歇根大学毕业典礼" width={544} height={544} class="size-full object-cover" loading="eager" />
          <div class="absolute inset-0 bg-bg/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true">
            <AttentionField spacing={16} sigma={46} topK={5} />
          </div>
        </div>
      </div>
    </section>

    <Section eyebrow={ui.work} class="animate">
      <a slot="action" href="/zh/work" class="link-quiet">{ui.allRoles}</a>
      <ul class="rule-list">{work.slice(0, 3).map((entry) => <WorkRow entry={entry} compact lang="zh" />)}</ul>
    </Section>

    <Section eyebrow={ui.education} class="animate">
      <ul class="rule-list">{EDUCATION.map((edu) => <EducationRow edu={edu} compact lang="zh" />)}</ul>
      <figure class="mt-5">
        <Image src={campus} alt="穿着学位服坐在 Michigan Union 标牌上，安娜堡，2025 年 5 月" widths={[640, 960, 1408]} sizes="(min-width: 768px) 704px, 100vw" class="w-full rounded-lg border border-border" />
        <figcaption class="mt-2 font-mono text-[12px] text-fg-subtle">Michigan Union，安娜堡 · 2025 年 5 月</figcaption>
      </figure>
    </Section>

    <Section eyebrow={ui.projects} class="animate">
      <a slot="action" href="/zh/projects" class="link-quiet">{ui.allProjects}</a>
      <ul class="rule-list">{projects.map((p) => <ProjectRow project={p} lang="zh" />)}</ul>
    </Section>

    <Section eyebrow={ui.research} class="animate">
      <a slot="action" href="/zh/research" class="link-quiet">{ui.more}</a>
      <ul class="rule-list">
        {
          research.map((r) => (
            <li class="py-3">
              <div class="flex flex-wrap items-baseline gap-x-2">
                {r.data.logo && <Logo name={r.data.logo} class="mr-0.5" />}
                <a href="/zh/research" class="link font-medium">{r.data.title_zh ?? r.data.title}</a>
                <span class="text-sm text-fg-subtle">· {r.data.venue_zh ?? r.data.venue}</span>
              </div>
              <p class="mt-0.5 text-[15px] leading-relaxed text-fg-muted">{r.data.summary_zh ?? r.data.summary}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section eyebrow={ui.off} class="animate">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-fg-muted">
        {
          HOBBIES.map((h) => (
            <li class="flex items-center gap-1.5">
              <HobbyIcon name={h.ICON} class="size-4 text-fg-subtle" />
              {h.LABEL_ZH}
            </li>
          ))
        }
      </ul>
    </Section>
  </Container>
  <Behaviors />
</BaseLayout>
