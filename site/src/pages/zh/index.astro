---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import headshot from "@assets/photos/headshot.jpg";
import AttentionField from "@components/AttentionField.astro";
import Behaviors from "@components/Behaviors.astro";
import EducationCard from "@components/EducationCard.astro";
import HobbyIcon from "@components/HobbyIcon.astro";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import WorkRow from "@components/WorkRow.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { EDUCATION, HOBBIES, SITE, SOCIALS, UI } from "@site.config";

const ui = UI.zh;
const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
const github = SOCIALS.find((s) => s.NAME === "github")?.HREF ?? "#";
const linkedin = SOCIALS.find((s) => s.NAME === "linkedin")?.HREF ?? "#";
---

<BaseLayout
  lang="zh"
  title="Home"
  description="蒲浩领 Haoling Pu — 机器学习系统工程师，卡内基梅隆大学 AI 硕士，Google 实习，CUDA 算子、LLM 智能体、同声传译研究。"
>
  <Container>
    <section class="animate">
      <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between sm:gap-12">
        <div class="max-w-[40rem] flex-1">
          <h1 class="text-[28px] font-semibold tracking-tight sm:text-[32px]">蒲浩领 <span class="ml-1 text-[18px] font-normal text-fg-subtle sm:text-[20px]">Haoling Pu</span></h1>
          <p class="mt-1 text-[15px] text-fg-subtle">机器学习系统工程师 · 卡内基梅隆大学 人工智能与创新 硕士，2027 届 · 匹兹堡</p>
          <ul class="mt-4 flex flex-wrap items-center gap-2" aria-label="Links">
            <li><a href={github} target="_blank" rel="noopener noreferrer" class="chip"><svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>GitHub</a></li>
            <li><a href={linkedin} target="_blank" rel="noopener noreferrer" class="chip"><svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1zM7.1 20.4H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>LinkedIn</a></li>
            <li><a href="/Haoling_Pu_Resume.pdf" target="_blank" rel="noopener noreferrer" class="chip chip-accent"><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[1.8]" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>简历</a></li>
            <li><button type="button" data-copy={SITE.EMAIL} class="chip" aria-label={`复制邮箱 ${SITE.EMAIL}`}><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[1.8]" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span class="when-idle">邮箱</span><span class="when-copied">已复制 ✓</span></button></li>
          </ul>

                    <div class="prose mt-6 text-[16.5px] leading-[1.85]">
            <p>
              我是<a href="https://www.cs.cmu.edu">卡内基梅隆大学计算机学院</a>的硕士生，做机器学习系统。我最喜欢模型与硬件、产品交汇的那一层：算子、推理服务，以及跑在它们之上的智能体。
            </p>
            <p>
              现在我在 CMU 的<a href="https://www.lti.cs.cmu.edu">语言技术研究所</a>做同声传译方向的研究：让模型在说话人还没说完的时候，就决定该翻译什么。去年夏天在 <a href="https://about.google">Google</a>，我教会一个智能体让团队的知识库自己活起来。再往前，是<a href="https://umich.edu">密歇根大学</a>的计算机科学。
            </p>
            <p>
              这个网站放的是我自己觉得有意思的那部分。邮件是最方便的联系方式。
            </p>
          </div>
        </div>
        <!-- Photo. The attention field stays as a hover overlay (ROADMAP G9). -->
        <div class="group relative aspect-[2/3] w-44 shrink-0 overflow-hidden rounded-xl border border-border bg-surface sm:w-56 md:w-[17rem]">
          <Image src={headshot} alt="蒲浩领，密歇根大学毕业典礼" widths={[272, 544]} sizes="(min-width: 768px) 272px, (min-width: 640px) 224px, 176px" class="size-full object-cover" loading="eager" />
          <div class="absolute inset-0 bg-bg/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true">
            <AttentionField spacing={16} sigma={46} topK={5} />
          </div>
        </div>
      </div>
    </section>

    <Section eyebrow={ui.work} class="animate">
      <a slot="action" href="/zh/work" class="link-quiet">{ui.allRoles}</a>
      <ul class="rule-list">{work.slice(0, 3).map((entry) => <WorkRow entry={entry} compact lang="zh" />)}</ul>
    </Section>

    <Section eyebrow={ui.education} class="animate">
      <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2">{EDUCATION.map((edu) => <EducationCard edu={edu} lang="zh" />)}</ul>
    </Section>



    <Section eyebrow={ui.off} class="animate">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-fg-muted">
        {
          HOBBIES.map((h) => (
            <li class="flex items-center gap-1.5">
              <HobbyIcon name={h.ICON} class="size-4 text-fg-subtle" />
              {h.LABEL_ZH}
            </li>
          ))
        }
      </ul>
    </Section>
  </Container>
  <Behaviors />
</BaseLayout>
