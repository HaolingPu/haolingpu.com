---
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import type { Lang } from "@site.config";
import { SITE } from "@site.config";
import Analytics from "@vercel/analytics/astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  bodyClass?: string;
  noindex?: boolean;
  lang?: Lang;
  type?: "website" | "article";
};

const { title, description, image, bodyClass, noindex, lang = "en", type } = Astro.props;
const siteName = lang === "zh" ? `${SITE.NAME_ZH} ${SITE.NAME}` : SITE.NAME;
const fullTitle = title === "Home" ? siteName : `${title} · ${siteName}`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <Head title={fullTitle} description={description} image={image} noindex={noindex} type={type} />
  </head>
  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
