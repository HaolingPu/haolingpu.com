---
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import { SITE } from "@site.config";

type Props = {
  title: string;
  description: string;
  image?: string;
  bodyClass?: string;
};

const { title, description, image, bodyClass } = Astro.props;
const fullTitle = title === "Home" ? SITE.NAME : `${title} · ${SITE.NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={fullTitle} description={description} image={image} />
  </head>
  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
